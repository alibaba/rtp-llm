    "generate_config": {
      "top_k": 1
    },
    "profiling": {
      "enabled": false
    }
  },
  "execution": {
    "backend": "aone",
    "resource": "daily",
    "gpu_type": "H20_CU13",
    "max_parallel": 2,
    "gpus_per_machine": 1
  },
  "output": {
    "result_root": "perf_test_results"
  },
  "regression": {},
  "publish": {}
}
