<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{48} - %msg%n</pattern>
    </encoder>
  </appender>
  <!-- Engine runs without Spring Boot initialization; do not inherit Logback's DEBUG default. -->
  <root level="INFO">
    <appender-ref ref="CONSOLE" />
  </root>
</configuration>
