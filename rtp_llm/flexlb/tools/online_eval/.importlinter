[importlinter]
root_packages =
    analysis
    cases
    scenario
    reporting
    scripts
    monitoring
    runtime
    artifacts
    adapters
    traffic

[importlinter:contract:analysis]
name = 分析不依赖报表
type = forbidden
source_modules =
    analysis
    cases.*.analysis
forbidden_modules =
    reporting
    cases.*.report
    cases.*.panels

[importlinter:contract:inputs]
name = 输入契约不依赖编译器
type = forbidden
source_modules =
    cases.*.inputs
forbidden_modules =
    scenario.compiler
    scenario.program_compiler
    scenario.stage_compiler

[importlinter:contract:authoring]
name = 用例构建合同不依赖业务实现
type = forbidden
source_modules =
    scenario.builder
    scenario.contracts
    scenario.inputs
    scenario.gates
forbidden_modules =
    cases
    scenario.measurement

[importlinter:contract:scenario]
name = 场景库不依赖命令脚本
type = forbidden
source_modules =
    scenario
forbidden_modules =
    scripts
