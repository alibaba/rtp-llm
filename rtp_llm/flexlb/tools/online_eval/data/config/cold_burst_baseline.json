{
  "schemaVersion": 3,
  "scheduler": {
    "type": "QUEUE",
    "decision": {
      "type": "SINGLE"
    }
  },
  "dispatcher": {
    "type": "NON_BATCH",
    "maxInflightPerPrefillWorker": 256
  },
  "dispatchTimeoutMs": 120000,
  "router": {
    "roles": {
      "prefill": {
        "tokenBalance": {
          "hotspotRescue": {
            "maxInputTokens": 32768,
            "maxIdlePendingTokens": 64768,
            "migrationIntervalMs": 1000
          },
          "minPrefixHitPercent": 5,
          "enableWindow": false,
          "engineQueueAdmissionThreshold": 30,
          "maxPendingComputeTokens": 200000
        }
      }
    }
  }
}
