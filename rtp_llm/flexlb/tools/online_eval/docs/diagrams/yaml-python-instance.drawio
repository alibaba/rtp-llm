        <mxCell id="input" value="&lt;b&gt;确定的一组输入&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;环境：Java Mock，1 Master + 2P + 2D&lt;br/&gt;profile：FIXED_WINDOW + BATCH&lt;br/&gt;请求：2048 输入 / 2 输出 / 1 条&lt;br/&gt;预算：实例 300s；默认阶段 60s&lt;br/&gt;setup 单独 180s；清理 120s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#172b4d;fontFamily=PingFang SC;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=18" vertex="1" parent="1">
