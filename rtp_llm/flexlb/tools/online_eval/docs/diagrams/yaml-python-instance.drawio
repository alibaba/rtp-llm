        <mxCell id="steps" value="&lt;b&gt;Python 固定执行顺序&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;setup → submit → terminal&lt;br/&gt;→ completed → no_errors → cleanup&lt;br/&gt;检查 1：completed == true&lt;br/&gt;检查 2：error_count == 0&lt;br/&gt;失败 / 超时后仍执行兜底清理" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#172b4d;fontFamily=PingFang SC;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=18" vertex="1" parent="1">
