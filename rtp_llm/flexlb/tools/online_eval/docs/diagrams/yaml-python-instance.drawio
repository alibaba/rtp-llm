        <mxCell id="compile" value="&lt;b&gt;compiler.py · 按 variant 与适用 profile 展开&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;合并根配置和变体覆盖，解析有效环境与能力&lt;br/&gt;实例 ID = 配置 id :: 变体 id :: profile&lt;br/&gt;每个计划包含环境、步骤、检查、预算与来源哈希" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#172b4d;fontFamily=PingFang SC;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;spacing=18" vertex="1" parent="1">
