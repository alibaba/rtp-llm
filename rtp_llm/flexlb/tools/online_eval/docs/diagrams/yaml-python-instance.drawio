        <mxCell id="runtime" value="&lt;b&gt;parallel_runner → scenario_runner → runtime&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;父进程分配 lane、端口范围与锁；子进程执行实例&lt;br/&gt;Python action / JavaMockBackend 启动并操作 Master + P/D&lt;br/&gt;每个实例独立环境、结果与清理；失败后仍做兜底清理" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#172b4d;fontFamily=PingFang SC;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;spacing=18" vertex="1" parent="1">
          <mxGeometry x="255" y="740" width="795" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="note-runtime" value="&lt;b&gt;这一层才运行被测服务&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;lane 是并发资源通道，不是 case。&lt;br/&gt;多个实例可在同一 lane 先后执行。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=PingFang SC;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=18" vertex="1" parent="1">
