        <mxCell id="note-yaml" value="&lt;b&gt;这一层回答：用什么条件测？&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;不定义步骤顺序、分支或断言。&lt;br/&gt;同一 Python 程序可配多份 YAML。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=PingFang SC;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=18" vertex="1" parent="1">
