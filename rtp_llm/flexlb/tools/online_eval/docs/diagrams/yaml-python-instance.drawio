        <mxCell id="yaml" value="&lt;b&gt;YAML · scenarios/*.yaml&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;case / id / variants / profiles&lt;br/&gt;environment：P/D 数量、KV、性能预设&lt;br/&gt;parameters：Python 声明的输入；execution：时间预算" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#172b4d;fontFamily=PingFang SC;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;spacing=18" vertex="1" parent="1">
