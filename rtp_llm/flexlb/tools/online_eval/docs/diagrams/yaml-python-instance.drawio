        <mxCell id="identity" value="ID 由名称构成，不包含参数值：同名配置改参数时靠配置哈希辨别。多组规模同时登记，应使用不同配置 id 或变体 id。&lt;br/&gt;完整 385 实例映射见 case-instance-map.csv；本图与清单依据 4f7b820368 编译生成。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=PingFang SC;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=18;spacing=0;fontColor=#52657e" vertex="1" parent="1">
