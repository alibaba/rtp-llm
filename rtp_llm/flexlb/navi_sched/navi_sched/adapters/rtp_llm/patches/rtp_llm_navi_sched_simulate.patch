@@ -0,0 +1,66 @@
+import asyncio
+import importlib
+from pathlib import Path
+import sys
+import types
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+
+class _FakeClient:
+    def __init__(self, **kwargs):
+        self.kwargs = kwargs
+
+
+class _FakeAdapter(types.ModuleType):
+    class NaviSchedAdapterConfig:
+        def __init__(self, **kwargs):
+            self.__dict__.update(kwargs)
+
+    def __init__(self):
+        super().__init__("navi_sched.adapters.rtp_llm")
+        self.client = None
+
+    def NaviSchedClient(self, **kwargs):
+        self.client = _FakeClient(**kwargs)
+        return self.client
+
+
+class _MasterVip:
+    domain = "master.example"
+    use_local = False
+
+    @staticmethod
+    def get_hosts(refresh=False):
+        return [SimpleNamespace(ip="10.0.0.1", port="8088")]
+
+
+class NaviSchedSimulationAdapterTest(unittest.TestCase):
+    def test_frontend_has_no_model_rpc_client(self):
+        source = (
+            Path(__file__).parents[1] / "backend_rpc_server_visitor.py"
+        ).read_text()
+        self.assertNotIn("ModelRpcClient(", source)
+
+    def test_client_always_uses_forward_and_master_port_plus_one(self):
+        module = importlib.import_module("rtp_llm.server.navi_sched_adapter")
+        adapter = _FakeAdapter()
+        with patch.object(module, "_load_adapter", return_value=adapter):
+            client = module.create_navi_sched_client(
+                SimpleNamespace(master_vip=_MasterVip())
+            )
+
+        self.assertIs(client, adapter.client)
+        self.assertTrue(client.kwargs["enable_agent_forward"])
+        self.assertEqual(
+            "10.0.0.1:8089",
+            client.kwargs["host_service"].master_vip.domain,
+        )
+        self.assertTrue(client.kwargs["host_service"].master_vip.use_local)
+        self.assertEqual("rtp_llm_master", client.kwargs["config"].master_biz_name)
+        self.assertEqual("rtp_llm_prefill", client.kwargs["config"].biz_name)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/rtp_llm/server/test/navi_sched_simulation_role_test.py b/rtp_llm/server/test/navi_sched_simulation_role_test.py
