index 000000000..37d9cb357
--- /dev/null
+++ b/rtp_llm/navi_sched_simulate.py
@@ -0,0 +1,199 @@
+import json
+import logging
+import os
+import signal
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+from rtp_llm.ops import RoleType
+
+MASTER_BIZ_NAME = "rtp_llm_master"
+PREFILL_BIZ_NAME = "rtp_llm_prefill"
+BLOCK_SIZE = 256
+
+
+class _HealthHandler(BaseHTTPRequestHandler):
+    master_address = ""
+
+    def do_GET(self):
+        if self.path in {
+            "/health",
+            "/frontend_health",
+            "/hook/process_ok",
+            "/hook/after_start",
+        }:
+            self._write(200, b"ok", "text/plain")
+            return
+        if self.path == "/actuator/health":
+            self._write(200, b'{"status":"UP"}', "application/json")
+            return
+        self.send_error(404)
+
+    def do_POST(self):
+        if self.path == "/rtp_llm/master/info" and self.master_address:
+            body = json.dumps({
+                "real_master_host": self.master_address,
+                "queue_length": 0,
+                "ready": True,
+            }).encode()
+            self._write(200, body, "application/json")
+            return
+        if self.path in {"/health", "/frontend_health"}:
+            self._write(200, b"ok", "text/plain")
+            return
+        self.send_error(404)
+
+    def log_message(self, format, *args):
+        return
+
+    def _write(self, status, body, content_type):
+        self.send_response(status)
+        self.send_header("Content-Type", content_type)
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+
+def _runtime_options(name, grpc_port):
+    log_dir = os.environ.get("LOG_PATH", "logs")
+    runtime_dir = os.path.join(log_dir, "navi_sched")
+    os.makedirs(runtime_dir, exist_ok=True)
+    return {
+        "name": name,
+        "enable_kmon": False,
+        "wait_no_query": False,
+        "log_file_name": os.path.join(log_dir, "navi_sched.log"),
+        "snapshot_dir": runtime_dir,
+        "gig": {
+            "grpc_port": grpc_port,
+            "log_prefix": name,
+            "snapshot_log_dir": runtime_dir,
+        },
+    }
+
+
+def _advertised_ip(server_config):
+    return str(server_config.ip or os.environ.get("POD_IP", "127.0.0.1"))
+
+
+def _prefill_nodes():
+    from rtp_llm.server.host_service import HostServiceArgs, VipServerWrapper
+
+    host_args = HostServiceArgs.create_from_env()
+    if not host_args.prefill_domain:
+        raise RuntimeError("MODEL_SERVICE_CONFIG has no prefill endpoint")
+    vip = VipServerWrapper(host_args.prefill_domain, host_args.use_local)
+    nodes = []
+    deadline = time.monotonic() + 3600
+    while not nodes and time.monotonic() < deadline:
+        for host in vip.get_hosts(refresh=True):
+            nodes.append({
+                "biz_name": PREFILL_BIZ_NAME,
+                "ip": host.ip,
+                "grpc_port": int(host.port) + 1,
+                "support_heartbeat": True,
+            })
+        if not nodes:
+            time.sleep(1)
+    if not nodes:
+        raise RuntimeError("no simulated Prefill node is available")
+    return nodes
+
+
+def _serve_role(role, http_port, master=False):
+    if not 0 < http_port < 65535:
+        raise ValueError("START_PORT must leave room for the Gig port")
+    _HealthHandler.master_address = (
+        f"{_advertised_ip(role.server_config)}:{http_port}" if master else ""
+    )
+    server = ThreadingHTTPServer(("", http_port), _HealthHandler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    stopped = threading.Event()
+
+    def stop(signum, frame):
+        stopped.set()
+
+    signal.signal(signal.SIGINT, stop)
+    signal.signal(signal.SIGTERM, stop)
+    thread.start()
+    try:
+        stopped.wait()
+    finally:
+        server.shutdown()
+        server.server_close()
+
+
+def _run_master(py_env_configs):
+    from navi_sched import NaviSchedMaster
+
+    port = int(py_env_configs.server_config.start_port)
+    options = _runtime_options("sched_master", port + 1)
+    with NaviSchedMaster(
+        MASTER_BIZ_NAME,
+        runtime_config={"local_nodes": _prefill_nodes()},
+        max_wait_schedule_count=30,
+        max_wait_schedule_time_ms=0,
+        scheduler_name="random",
+        **options,
+    ) as master:
+        master.init()
+        _serve_role(py_env_configs, port, master=True)
+
+
+def _run_prefill(py_env_configs):
+    import navi_sched
+    from navi_sched import NaviSchedAgent
+
+    port = int(py_env_configs.server_config.start_port)
+    cache_capacity = 300 * 1024**3
+    token_cache_bytes = 10 * 1024
+    total_blocks = cache_capacity // (token_cache_bytes * BLOCK_SIZE)
+    options = _runtime_options("sched_agent", port + 1)
+    agent = NaviSchedAgent(
+        PREFILL_BIZ_NAME,
+        server_port=port,
+        server_ip=_advertised_ip(py_env_configs.server_config),
+        total_blocks=total_blocks,
+        runtime_config={},
+        **options,
+    )
+    config = navi_sched._navi_sched_core.NaviSchedSimulatedExecutionConfig()
+    config.cache_capacity_bytes = cache_capacity
+    config.token_cache_bytes = token_cache_bytes
+    config.noise_stddev_ratio = 0.01
+    config.time_compression = 1.0
+    handle = navi_sched._navi_sched_core.init_simulated_agent(agent, config)
+    if not handle:
+        agent.stop()
+        raise RuntimeError("failed to initialize simulated NaviSched Agent")
+    try:
+        _serve_role(py_env_configs, port)
+    finally:
+        handle.stop()
+        agent.stop()
+
+
+def _run_frontend(py_env_configs, configure):
+    from rtp_llm.start_frontend_server import start_frontend_server
+    from rtp_llm.utils.concurrency_controller import init_controller
+
+    configure(py_env_configs)
+    controller = init_controller(
+        py_env_configs.concurrency_config,
+        dp_size=py_env_configs.parallelism_config.dp_size,
+    )
+    start_frontend_server(0, 0, controller, py_env_configs)
+
+
+def run(py_env_configs, configure):
+    role = py_env_configs.role_config.role_type
+    logging.info("starting NaviSched RTP simulation role %s", role)
+    if role == RoleType.FRONTEND:
+        _run_frontend(py_env_configs, configure)
+    elif role == RoleType.PREFILL:
+        _run_prefill(py_env_configs)
+    elif role == RoleType.PDFUSION:
+        _run_master(py_env_configs)
+    else:
+        raise ValueError(f"unsupported NaviSched RTP simulation role: {role}")
