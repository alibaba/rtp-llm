@@ -0,0 +1,118 @@
+import importlib
+import http.client
+import json
+import socket
+import sys
+import threading
+import types
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+
+class _RoleType:
+    FRONTEND = 1
+    PREFILL = 2
+    PDFUSION = 3
+    DECODE = 4
+
+
+ops = types.ModuleType("rtp_llm.ops")
+ops.RoleType = _RoleType
+sys.modules.setdefault("rtp_llm.ops", ops)
+
+module = importlib.import_module("rtp_llm.navi_sched_simulate")
+
+
+class NaviSchedSimulationRoleTest(unittest.TestCase):
+    def test_role_dispatch(self):
+        for role, function_name in (
+            (_RoleType.FRONTEND, "_run_frontend"),
+            (_RoleType.PREFILL, "_run_prefill"),
+            (_RoleType.PDFUSION, "_run_master"),
+        ):
+            config = SimpleNamespace(
+                role_config=SimpleNamespace(role_type=role)
+            )
+            with patch.object(module, function_name) as selected:
+                module.run(config, "configure")
+                if function_name == "_run_frontend":
+                    selected.assert_called_once_with(config, "configure")
+                else:
+                    selected.assert_called_once_with(config)
+
+    def test_decode_is_not_supported(self):
+        config = SimpleNamespace(
+            role_config=SimpleNamespace(role_type=_RoleType.DECODE)
+        )
+        with self.assertRaisesRegex(ValueError, "unsupported"):
+            module.run(config, None)
+
+    def test_runtime_ports_are_fixed_to_http_plus_one(self):
+        options = module._runtime_options("role", 9001)
+        self.assertEqual(9001, options["gig"]["grpc_port"])
+
+    def test_master_heartbeat_protocol(self):
+        server = module.ThreadingHTTPServer(("127.0.0.1", 0), module._HealthHandler)
+        module._HealthHandler.master_address = "127.0.0.1:8088"
+        thread = threading.Thread(target=server.serve_forever)
+        thread.start()
+        try:
+            connection = http.client.HTTPConnection(
+                "127.0.0.1", server.server_port, timeout=1
+            )
+            connection.request("POST", "/rtp_llm/master/info", b"{}")
+            response = connection.getresponse()
+            payload = json.loads(response.read())
+            self.assertEqual(200, response.status)
+            self.assertEqual("127.0.0.1:8088", payload["real_master_host"])
+            self.assertEqual(0, payload["queue_length"])
+            self.assertTrue(payload["ready"])
+        finally:
+            server.shutdown()
+            server.server_close()
+            thread.join()
+
+    def test_prefill_attaches_simulated_agent(self):
+        calls = []
+
+        class Agent:
+            def __init__(self, *args, **kwargs):
+                calls.append((args, kwargs))
+
+            def stop(self):
+                calls.append("agent_stop")
+
+        class SimulateConfig:
+            pass
+
+        class Handle:
+            def stop(self):
+                calls.append("handle_stop")
+
+        core = SimpleNamespace(
+            NaviSchedSimulatedExecutionConfig=SimulateConfig,
+            init_simulated_agent=lambda agent, config: calls.append(
+                ("attach", agent, config)
+            ) or Handle(),
+        )
+        navi_sched = types.ModuleType("navi_sched")
+        navi_sched.NaviSchedAgent = Agent
+        navi_sched._navi_sched_core = core
+        config = SimpleNamespace(
+            server_config=SimpleNamespace(start_port=8088, ip="127.0.0.1")
+        )
+        with patch.dict(sys.modules, {"navi_sched": navi_sched}), patch.object(
+            module, "_serve_role", return_value=None
+        ) as serve:
+            module._run_prefill(config)
+
+        self.assertEqual("rtp_llm_prefill", calls[0][0][0])
+        self.assertEqual(8089, calls[0][1]["gig"]["grpc_port"])
+        self.assertEqual("attach", calls[1][0])
+        serve.assert_called_once_with(config, 8088)
+        self.assertEqual(["handle_stop", "agent_stop"], calls[-2:])
+
+
+if __name__ == "__main__":
+    unittest.main()
