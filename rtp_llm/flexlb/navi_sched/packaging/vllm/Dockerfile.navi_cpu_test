ARG CPU_BASE_IMAGE
FROM ${CPU_BASE_IMAGE}
ARG NAVI_COMMIT
ARG RTP_INTERNAL_COMMIT
ARG VLLM_COMMIT
ARG VLLM_BRANCH
RUN --mount=type=bind,source=navi_sched_dist,target=/tmp/navi_build \
    sh /tmp/navi_build/integration/install_vllm.sh \
      /opt/conda310/bin/python "$VLLM_BRANCH" "$VLLM_COMMIT" amd64 \
      "$NAVI_COMMIT" "$RTP_INTERNAL_COMMIT" flexlb_adapt
