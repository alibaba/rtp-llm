<project
  xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
>
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.flexlb</groupId>
    <artifactId>flexlb</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>flexlb-mock-engine</artifactId>
  <name>FlexLB Java Mock Engine</name>

  <dependencies>
    <dependency>
      <groupId>org.flexlb</groupId>
      <artifactId>flexlb-grpc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flexlb</groupId>
      <artifactId>flexlb-sync</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin><groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><executions><execution><id>sync-test-fixtures</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals><configuration><sources><source>${project.basedir}/../flexlb-sync/src/testFixtures/java</source></sources></configuration></execution></executions></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.2.4</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
              <transformers combine.self="override">
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"
                />
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"
                >
                  <mainClass
                  >org.flexlb.mockengine.JavaMockEngineCluster</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
