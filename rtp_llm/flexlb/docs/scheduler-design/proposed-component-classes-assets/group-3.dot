digraph G {
graph [rankdir=LR, bgcolor="transparent", nodesep=0.3, ranksep=0.65, pad=0.15];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=10, color="#64748b"];
"RequestWorkerSelector" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>RequestWorkerSelector</B><BR/>class · 450 LOC</TD></TR><TR><TD ALIGN="LEFT">- EndpointRegistry endpoints<BR ALIGN="LEFT"/>- PrefillSelectionStrategy prefill<BR ALIGN="LEFT"/>- DecodeSelectionStrategy decode<BR ALIGN="LEFT"/>- VitSelectionStrategy vit<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ select(ctx): PlacementAttempt<BR ALIGN="LEFT"/>+ selectVit(ctx): VitResult<BR ALIGN="LEFT"/>- reserveRoute(ctx, selection): PlacementAttempt<BR ALIGN="LEFT"/>- rollbackPartial(attempt): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PrefillSelectionStrategy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#e6f2ff"><B>PrefillSelectionStrategy</B><BR/>interface · 100 LOC</TD></TR><TR><TD ALIGN="LEFT">+ select(request, candidates, now): SelectionResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"CostBasedPrefillStrategy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>CostBasedPrefillStrategy</B><BR/>class · 350 LOC</TD></TR><TR><TD ALIGN="LEFT">- CacheAwareService cache<BR ALIGN="LEFT"/>- RequestTimeEstimation estimation<BR ALIGN="LEFT"/>- RoutingConfig config<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ select(request, candidates, now): SelectionResult<BR ALIGN="LEFT"/>- scoreCandidates(request, candidates): Scores<BR ALIGN="LEFT"/>- choose(scores): SelectionResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"DecodeSelectionStrategy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#e6f2ff"><B>DecodeSelectionStrategy</B><BR/>interface · 70 LOC</TD></TR><TR><TD ALIGN="LEFT">+ select(request, candidates, capacityReader): SelectionResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"DecodeSelector" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>DecodeSelector</B><BR/>class · 400 LOC</TD></TR><TR><TD ALIGN="LEFT">- RoutingConfig config<BR ALIGN="LEFT"/>- Map&lt;GroupKey, Cursor&gt; rotation<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ select(request, candidates, capacityReader): SelectionResult<BR ALIGN="LEFT"/>- findEligible(request, candidates): Candidates<BR ALIGN="LEFT"/>- classifyCapacityFailure(request, candidates): Failure<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"VitSelectionStrategy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#e6f2ff"><B>VitSelectionStrategy</B><BR/>interface · 30 LOC</TD></TR><TR><TD ALIGN="LEFT">+ selectIndex(addresses): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"VitWorkerSelector" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>VitWorkerSelector</B><BR/>class · 60 LOC</TD></TR><TR><TD ALIGN="LEFT">- AtomicLong cursor<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ selectIndex(addresses): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RequestWorkerSelector" -> "PrefillSelectionStrategy" [style=dashed, arrowhead=vee, label="select"];
"RequestWorkerSelector" -> "DecodeSelectionStrategy" [style=dashed, arrowhead=vee, label="select"];
"RequestWorkerSelector" -> "VitSelectionStrategy" [style=dashed, arrowhead=vee, label="select"];
"CostBasedPrefillStrategy" -> "PrefillSelectionStrategy" [style=dashed, arrowhead=empty, label=""];
"DecodeSelector" -> "DecodeSelectionStrategy" [style=dashed, arrowhead=empty, label=""];
"VitWorkerSelector" -> "VitSelectionStrategy" [style=dashed, arrowhead=empty, label=""];
}