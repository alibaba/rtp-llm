digraph G {
graph [rankdir=LR, bgcolor="transparent", nodesep=0.3, ranksep=0.65, pad=0.15];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=10, color="#64748b"];
"PrefillTimePredictor" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#e6f2ff"><B>PrefillTimePredictor</B><BR/>interface · 200 LOC</TD></TR><TR><TD ALIGN="LEFT">+ evaluator(): Evaluator<BR ALIGN="LEFT"/>+ learn(features, predicted, actual): LearningResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FormulaPredictor" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>FormulaPredictor</B><BR/>class · 300 LOC</TD></TR><TR><TD ALIGN="LEFT">- CompiledExpression expression<BR ALIGN="LEFT"/>- Evaluator model<BR ALIGN="LEFT"/>- ThreadLocal&lt;Bindings&gt; bindings<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ evaluator(): Evaluator<BR ALIGN="LEFT"/>+ learn(features, predicted, actual): LearningResult<BR ALIGN="LEFT"/>- evaluateRequest(input): long<BR ALIGN="LEFT"/>- evaluateBatch(features): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"LearningPredictor" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>LearningPredictor</B><BR/>class · 450 LOC</TD></TR><TR><TD ALIGN="LEFT">- volatile Evaluator model<BR ALIGN="LEFT"/>- TrainingState training<BR ALIGN="LEFT"/>- ModelConfig config<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ evaluator(): Evaluator<BR ALIGN="LEFT"/>+ learn(features, predicted, actual): LearningResult<BR ALIGN="LEFT"/>- updateModel(sample): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RequestTimeEstimation" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>RequestTimeEstimation</B><BR/>class · 550 LOC</TD></TR><TR><TD ALIGN="LEFT">- GroupPlanner grouping<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ estimate(request, snapshot, evaluator): Estimate<BR ALIGN="LEFT"/>- insertCandidate(request, snapshot): OrderedInputs<BR ALIGN="LEFT"/>- simulateGroups(inputs, limits, evaluator): Estimate<BR ALIGN="LEFT"/>- remainingWork(snapshot, now): long<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"DeliveryMetricsReporter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>DeliveryMetricsReporter</B><BR/>class · 300 LOC</TD></TR><TR><TD ALIGN="LEFT">- FlexMonitor monitor<BR ALIGN="LEFT"/>- ExecutorStats executors<BR ALIGN="LEFT"/>- Supplier&lt;DeliveryStats&gt; stats<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ bindExecutorStats(stats): void<BR ALIGN="LEFT"/>+ reportDelivery(values): void<BR ALIGN="LEFT"/>+ reportLatency(values): void<BR ALIGN="LEFT"/>+ reportPrediction(values): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"EngineHealthReporter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>EngineHealthReporter</B><BR/>class · 300 LOC</TD></TR><TR><TD ALIGN="LEFT">- FlexMonitor monitor<BR ALIGN="LEFT"/>- EndpointStats endpoints<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ reportSnapshot(): void<BR ALIGN="LEFT"/>+ reportPoll(values): void<BR ALIGN="LEFT"/>+ reportRetirement(values): void<BR ALIGN="LEFT"/>+ reportShutdown(values): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RequestSchedulerReporter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>RequestSchedulerReporter</B><BR/>class · 250 LOC</TD></TR><TR><TD ALIGN="LEFT">- FlexMonitor monitor<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ reportSelection(values): void<BR ALIGN="LEFT"/>+ reportWait(values): void<BR ALIGN="LEFT"/>+ reportCancellation(values): void<BR ALIGN="LEFT"/>+ reportPreemption(values): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FormulaPredictor" -> "PrefillTimePredictor" [style=dashed, arrowhead=empty, label=""];
"LearningPredictor" -> "PrefillTimePredictor" [style=dashed, arrowhead=empty, label=""];
"RequestTimeEstimation" -> "PrefillTimePredictor" [style=dashed, arrowhead=vee, label="冻结 evaluator"];
}