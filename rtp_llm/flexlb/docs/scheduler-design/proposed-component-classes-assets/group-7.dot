digraph G {
graph [rankdir=LR, bgcolor="transparent", nodesep=0.3, ranksep=0.65, pad=0.15];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=10, color="#64748b"];
"PlacementConfiguration" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>PlacementConfiguration</B><BR/>class · 300 LOC</TD></TR><TR><TD ALIGN="LEFT">- ConfigService config<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ scheduler(lifecycle, selector, planner, queue, dispatcher, preemption): RequestScheduler<BR ALIGN="LEFT"/>+ workerQueueFactory(config): Factory<BR ALIGN="LEFT"/>+ prefillStrategy(cache, estimation, config): PrefillSelectionStrategy<BR ALIGN="LEFT"/>+ decodeStrategy(config): DecodeSelectionStrategy<BR ALIGN="LEFT"/>+ connectLifecycle(lifecycle, scheduler, dispatcher): void<BR ALIGN="LEFT"/>+ startScheduling(scheduler): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RequestTaskPool" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>RequestTaskPool</B><BR/>class · 300 LOC</TD></TR><TR><TD ALIGN="LEFT">- ExecutorService workers<BR ALIGN="LEFT"/>- TaskRegistrations accepted<BR ALIGN="LEFT"/>- PoolPhase phase<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ execute(owner, task): boolean<BR ALIGN="LEFT"/>+ stopAdmission(): void<BR ALIGN="LEFT"/>+ awaitIdle(deadline): boolean<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ScheduledTaskTimer" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>ScheduledTaskTimer</B><BR/>class · 150 LOC</TD></TR><TR><TD ALIGN="LEFT">- ScheduledExecutorService timer<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ schedule(task, delayMs): Cancellation<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ExpirationTimer" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>ExpirationTimer</B><BR/>class · 220 LOC</TD></TR><TR><TD ALIGN="LEFT">- TaskTimer timer<BR ALIGN="LEFT"/>- Map&lt;RequestIdentity, ScheduledDeadline&gt; deadlines<BR ALIGN="LEFT"/>- TimeoutListener listener<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ update(ctx, deadlines): void<BR ALIGN="LEFT"/>+ remove(ctx): void<BR ALIGN="LEFT"/>- fire(ctx, token): void<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ResponseCompletionExecutor" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>ResponseCompletionExecutor</B><BR/>class · 220 LOC</TD></TR><TR><TD ALIGN="LEFT">- ExecutorService workers<BR ALIGN="LEFT"/>- TaskRegistrations accepted<BR ALIGN="LEFT"/>- boolean accepting<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ complete(ctx, response): boolean<BR ALIGN="LEFT"/>+ execute(task): boolean<BR ALIGN="LEFT"/>+ stopAdmission(): void<BR ALIGN="LEFT"/>+ awaitIdle(deadline): boolean<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"WorkerStatusSynchronizer" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>WorkerStatusSynchronizer</B><BR/>class · 500 LOC</TD></TR><TR><TD ALIGN="LEFT">- EndpointRegistry endpoints<BR ALIGN="LEFT"/>- WorkerAddressService discovery<BR ALIGN="LEFT"/>- ExecutorService workers<BR ALIGN="LEFT"/>- ScheduledExecutorService timer<BR ALIGN="LEFT"/>- WorkerStatusRpcClient client<BR ALIGN="LEFT"/>- SyncConfig config<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ start(): void<BR ALIGN="LEFT"/>- pollWorkers(): void<BR ALIGN="LEFT"/>- pollCaches(): void<BR ALIGN="LEFT"/>- retireRemoved(): void<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"GrpcWorkerStatusRunner" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>GrpcWorkerStatusRunner</B><BR/>class · 350 LOC</TD></TR><TR><TD ALIGN="LEFT">- WorkerEndpoint endpoint<BR ALIGN="LEFT"/>- PollLease lease<BR ALIGN="LEFT"/>- WorkerStatusRpcClient client<BR ALIGN="LEFT"/>- EndpointRegistry registry<BR ALIGN="LEFT"/>- EngineHealthReporter reporter<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ run(): void<BR ALIGN="LEFT"/>- onResponse(reply, failure): void<BR ALIGN="LEFT"/>- applyStatus(status): void<BR ALIGN="LEFT"/>- finish(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"GrpcCacheStatusCheckRunner" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>GrpcCacheStatusCheckRunner</B><BR/>class · 300 LOC</TD></TR><TR><TD ALIGN="LEFT">- WorkerEndpoint endpoint<BR ALIGN="LEFT"/>- PollLease lease<BR ALIGN="LEFT"/>- WorkerStatusRpcClient client<BR ALIGN="LEFT"/>- CacheAwareService cache<BR ALIGN="LEFT"/>- DynamicCacheIntervalService intervals<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ run(): void<BR ALIGN="LEFT"/>- onResponse(reply, failure): void<BR ALIGN="LEFT"/>- applyCacheStatus(status): void<BR ALIGN="LEFT"/>- finish(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"WorkerStatusRpcClient" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>WorkerStatusRpcClient</B><BR/>class · 300 LOC</TD></TR><TR><TD ALIGN="LEFT">- EngineGrpcClient client<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ getWorkerStatus(identity, version, timeout): CompletionStage&lt;Status&gt;<BR ALIGN="LEFT"/>+ getCacheStatus(identity, version, timeout): CompletionStage&lt;CacheStatus&gt;<BR ALIGN="LEFT"/>- decodeStatus(reply): Status<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"WorkerAddressService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>WorkerAddressService</B><BR/>class · 180 LOC</TD></TR><TR><TD ALIGN="LEFT">- ServiceDiscovery discovery<BR ALIGN="LEFT"/>- ConfigService config<BR ALIGN="LEFT"/>- ExecutorService workers<BR ALIGN="LEFT"/>- AddressSnapshot current<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ refresh(): void<BR ALIGN="LEFT"/>+ addresses(role): List&lt;EndpointAddress&gt;<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ExpirationTimer" -> "ScheduledTaskTimer" [style=dashed, arrowhead=vee, label="经 TaskTimer"];
"WorkerStatusSynchronizer" -> "GrpcWorkerStatusRunner" [style=dashed, arrowhead=vee, label="轮询"];
"WorkerStatusSynchronizer" -> "GrpcCacheStatusCheckRunner" [style=dashed, arrowhead=vee, label="轮询"];
"GrpcWorkerStatusRunner" -> "WorkerStatusRpcClient" [style=dashed, arrowhead=vee, label="RPC"];
"GrpcCacheStatusCheckRunner" -> "WorkerStatusRpcClient" [style=dashed, arrowhead=vee, label="RPC"];
"WorkerStatusSynchronizer" -> "WorkerAddressService" [style=dashed, arrowhead=vee, label="发现"];
}