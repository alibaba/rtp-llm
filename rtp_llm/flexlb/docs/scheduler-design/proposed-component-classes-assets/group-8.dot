digraph G {
graph [rankdir=LR, bgcolor="transparent", nodesep=0.3, ranksep=0.65, pad=0.15];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=10, color="#64748b"];
"MasterStatusService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>MasterStatusService</B><BR/>class · 250 LOC</TD></TR><TR><TD ALIGN="LEFT">- AtomicReference&lt;MasterSnapshot&gt; current<BR ALIGN="LEFT"/>- LocalNode local<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ currentMaster(): MasterSnapshot<BR ALIGN="LEFT"/>+ isMaster(): boolean<BR ALIGN="LEFT"/>+ updateMaster(snapshot): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"MasterStatusView" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#e6f2ff"><B>MasterStatusView</B><BR/>interface · 30 LOC</TD></TR><TR><TD ALIGN="LEFT">+ currentMaster(): MasterSnapshot<BR ALIGN="LEFT"/>+ isMaster(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ZookeeperMasterElectService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>ZookeeperMasterElectService</B><BR/>class · 450 LOC</TD></TR><TR><TD ALIGN="LEFT">- ZkClient client<BR ALIGN="LEFT"/>- MasterStatusService status<BR ALIGN="LEFT"/>- LBConsistencyConfig config<BR ALIGN="LEFT"/>- ElectionHandle election<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ start(): void<BR ALIGN="LEFT"/>- onLeadershipChanged(event): void<BR ALIGN="LEFT"/>- publishStatus(): void<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"LBConsistencyConfig" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>LBConsistencyConfig</B><BR/>class · 60 LOC</TD></TR><TR><TD ALIGN="LEFT">- boolean needConsistency<BR ALIGN="LEFT"/>- MasterElectType masterElectType<BR ALIGN="LEFT"/>- ZookeeperConfig zookeeperConfig<BR ALIGN="LEFT"/>- String zkHost<BR ALIGN="LEFT"/>- int zkTimeoutMs<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ validate(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"MasterChangeNotifyReq" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>MasterChangeNotifyReq</B><BR/>class · 30 LOC</TD></TR><TR><TD ALIGN="LEFT">- String reqIp<BR ALIGN="LEFT"/>- String roleId<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"MasterChangeNotifyResp" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>MasterChangeNotifyResp</B><BR/>class · 30 LOC</TD></TR><TR><TD ALIGN="LEFT">- boolean success<BR ALIGN="LEFT"/>- String msg<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"SyncLBStatusReq" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>SyncLBStatusReq</B><BR/>class · 30 LOC</TD></TR><TR><TD ALIGN="LEFT">- String roleId<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"SyncLBStatusResp" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>SyncLBStatusResp</B><BR/>class · 40 LOC</TD></TR><TR><TD ALIGN="LEFT">- boolean success<BR ALIGN="LEFT"/>- String msg<BR ALIGN="LEFT"/>- String lbStatus<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PvLogData" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>PvLogData</B><BR/>class · 100 LOC</TD></TR><TR><TD ALIGN="LEFT">- final long requestId<BR ALIGN="LEFT"/>- final long seqLen<BR ALIGN="LEFT"/>- final Response response<BR ALIGN="LEFT"/>- final String error<BR ALIGN="LEFT"/>- final boolean success<BR ALIGN="LEFT"/>- final long enqueueTime<BR ALIGN="LEFT"/>- final long startTime<BR ALIGN="LEFT"/>- final long requestTimeMs<BR ALIGN="LEFT"/>- final int code<BR ALIGN="LEFT"/>- final String admissionRejectReason<BR ALIGN="LEFT"/>- final String scheduleOrigin<BR ALIGN="LEFT"/>- final int priority<BR ALIGN="LEFT"/>- final long requestExpiresAtMs<BR ALIGN="LEFT"/>- final long latencyMs<BR ALIGN="LEFT"/>- final long batchId<BR ALIGN="LEFT"/>- final String requestState<BR ALIGN="LEFT"/>- final String realMasterHost<BR ALIGN="LEFT"/>- final Map&lt;String, Object&gt; schedulingDiagnostics<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ from(ctx, result): PvLogData<BR ALIGN="LEFT"/>+ serialize(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RecentCacheKeyTraceReporter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>RecentCacheKeyTraceReporter</B><BR/>class · 300 LOC</TD></TR><TR><TD ALIGN="LEFT">- TraceBuffer buffer<BR ALIGN="LEFT"/>- TraceSink sink<BR ALIGN="LEFT"/>- TraceConfig config<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ record(trace): void<BR ALIGN="LEFT"/>+ flush(): void<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"VitCacheDirectory" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>VitCacheDirectory</B><BR/>class · 300 LOC</TD></TR><TR><TD ALIGN="LEFT">- CacheSnapshot current<BR ALIGN="LEFT"/>- Map&lt;CacheKey, Placement&gt; pending<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ snapshot(): CacheSnapshot<BR ALIGN="LEFT"/>+ reserve(key, endpoint): Reservation<BR ALIGN="LEFT"/>+ confirm(reservation): boolean<BR ALIGN="LEFT"/>+ release(reservation): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"VitCacheSelector" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>VitCacheSelector</B><BR/>class · 250 LOC</TD></TR><TR><TD ALIGN="LEFT">- VitCacheDirectory directory<BR ALIGN="LEFT"/>- VitSelectionStrategy strategy<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ select(request, candidates): Selection<BR ALIGN="LEFT"/>+ reservePlacement(selection): Reservation<BR ALIGN="LEFT"/>+ onPlacementResult(reservation, result): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Failures" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#fff3de"><B>Failures</B><BR/>utility · 100 LOC</TD></TR><TR><TD ALIGN="LEFT">+ append(first, next): Throwable<BR ALIGN="LEFT"/>+ run(failure, work): Throwable<BR ALIGN="LEFT"/>+ close(resource): Throwable<BR ALIGN="LEFT"/>+ rethrow(failure, detail): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"BatchIdGenerator" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>BatchIdGenerator</B><BR/>class · 100 LOC</TD></TR><TR><TD ALIGN="LEFT">- final long processIdentity<BR ALIGN="LEFT"/>- LongSupplier clock<BR ALIGN="LEFT"/>- long lastTime<BR ALIGN="LEFT"/>- long sequence<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ nextId(): long<BR ALIGN="LEFT"/>+ forCurrentProcess(): BatchIdGenerator<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"MasterStatusService" -> "MasterStatusView" [style=dashed, arrowhead=empty, label=""];
"ZookeeperMasterElectService" -> "MasterStatusService" [style=dashed, arrowhead=vee, label="发布主节点"];
"VitCacheSelector" -> "VitCacheDirectory" [style=dashed, arrowhead=vee, label="缓存事实 / 占位"];
}