digraph G {
graph [rankdir=LR, bgcolor="transparent", nodesep=0.3, ranksep=0.65, pad=0.15];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=10, color="#64748b"];
"EndpointRegistry" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>EndpointRegistry</B><BR/>class · 650 LOC</TD></TR><TR><TD ALIGN="LEFT">- Map&lt;EndpointKey, WorkerEndpoint&gt; discovered<BR ALIGN="LEFT"/>- PublishedEndpoints published<BR ALIGN="LEFT"/>- EndpointChangeListener changes<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ updateDiscovered(workers): void<BR ALIGN="LEFT"/>+ publish(endpoint): boolean<BR ALIGN="LEFT"/>+ find(identity): WorkerEndpoint<BR ALIGN="LEFT"/>+ routingSnapshot(role, group): RoutingSnapshot<BR ALIGN="LEFT"/>+ retire(identity): CompletionStage&lt;Void&gt;<BR ALIGN="LEFT"/>+ counts(role): Counts<BR ALIGN="LEFT"/>+ resourceStats(): ResourceStats<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"WorkerEndpoint" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>WorkerEndpoint</B><BR/>class · 300 LOC</TD></TR><TR><TD ALIGN="LEFT">- final EndpointIdentity identity<BR ALIGN="LEFT"/>- WorkerStatus status<BR ALIGN="LEFT"/>- GenerationPhase generationPhase<BR ALIGN="LEFT"/>- int activeUses<BR ALIGN="LEFT"/>- Completion retirement<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ identity(): EndpointIdentity<BR ALIGN="LEFT"/>+ acquireUse(): Use<BR ALIGN="LEFT"/>+ beginRetirement(): void<BR ALIGN="LEFT"/>+ awaitRetirement(deadline): boolean<BR ALIGN="LEFT"/>+ snapshotStatus(): StatusSnapshot<BR ALIGN="LEFT"/>- releaseUse(use): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PrefillEndpoint" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>PrefillEndpoint</B><BR/>class · 900 LOC</TD></TR><TR><TD ALIGN="LEFT">- ReentrantLock resourceLock<BR ALIGN="LEFT"/>- Map&lt;RouteIdentity, RequestRecord&gt; requests<BR ALIGN="LEFT"/>- Map&lt;BatchId, BatchRecord&gt; batches<BR ALIGN="LEFT"/>- PrefillRequestQueue queue<BR ALIGN="LEFT"/>- PrefillTimePredictor predictor<BR ALIGN="LEFT"/>- long version<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ reserveRequest(route, limits): ReserveResult<BR ALIGN="LEFT"/>+ reserveBatch(batchId, limits): ReserveResult<BR ALIGN="LEFT"/>+ commit(reservation, members, predictions): CommitResult<BR ALIGN="LEFT"/>+ rollback(reservation): boolean<BR ALIGN="LEFT"/>+ releaseRequest(identity, evidence): ReleaseResult<BR ALIGN="LEFT"/>+ applyEngineStatus(status): Changes<BR ALIGN="LEFT"/>+ snapshot(): PrefillSnapshot<BR ALIGN="LEFT"/>+ queueSnapshot(): QueueSnapshot<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"DecodeEndpoint" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>DecodeEndpoint</B><BR/>class · 900 LOC</TD></TR><TR><TD ALIGN="LEFT">- ReentrantLock resourceLock<BR ALIGN="LEFT"/>- Map&lt;ReservationId, RequestRecord&gt; requests<BR ALIGN="LEFT"/>- CapacityUsage usage<BR ALIGN="LEFT"/>- Map&lt;AttemptId, PreemptionRecord&gt; preemptions<BR ALIGN="LEFT"/>- long version<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ reserveRequest(route, limits): ReserveResult<BR ALIGN="LEFT"/>+ reserveDispatch(reservation): ReserveResult<BR ALIGN="LEFT"/>+ commitDispatch(reservation, deliveryId): CommitResult<BR ALIGN="LEFT"/>+ rollback(reservation): boolean<BR ALIGN="LEFT"/>+ releaseRequest(identity, evidence): ReleaseResult<BR ALIGN="LEFT"/>+ applyEngineStatus(status): Changes<BR ALIGN="LEFT"/>+ snapshot(): DecodeSnapshot<BR ALIGN="LEFT"/>+ claimVictims(attempt, proposal): ClaimResult<BR ALIGN="LEFT"/>+ updatePreemption(attempt, evidence): Changes<BR ALIGN="LEFT"/>+ releaseVictimClaim(attempt): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"EndpointStats" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#e6f2ff"><B>EndpointStats</B><BR/>interface · 50 LOC</TD></TR><TR><TD ALIGN="LEFT">+ counts(role): Counts<BR ALIGN="LEFT"/>+ resourceStats(): ResourceStats<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Delivery" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>Delivery</B><BR/>class · 300 LOC</TD></TR><TR><TD ALIGN="LEFT">- final long id<BR ALIGN="LEFT"/>- final List&lt;Member&gt; members<BR ALIGN="LEFT"/>- final SendMode mode<BR ALIGN="LEFT"/>- final PrefixPolicy prefixPolicy<BR ALIGN="LEFT"/>- Reservation batchReservation<BR ALIGN="LEFT"/>- DeliveryPermit executionPermit<BR ALIGN="LEFT"/>- SendProgress progress<BR ALIGN="LEFT"/>- CompletableFuture&lt;Result&gt; completion<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ id(): long<BR ALIGN="LEFT"/>+ members(): List&lt;Member&gt;<BR ALIGN="LEFT"/>+ beginTransport(): boolean<BR ALIGN="LEFT"/>+ recordResult(result): boolean<BR ALIGN="LEFT"/>+ result(): CompletionStage&lt;Result&gt;<BR ALIGN="LEFT"/>+ rollback(): void<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"DeliveryDispatcher" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>DeliveryDispatcher</B><BR/>class · 850 LOC</TD></TR><TR><TD ALIGN="LEFT">- EngineGrpcClient client<BR ALIGN="LEFT"/>- DeliveryExecution execution<BR ALIGN="LEFT"/>- RequestLifecycle lifecycle<BR ALIGN="LEFT"/>- TaskTimer timer<BR ALIGN="LEFT"/>- DeliveryMetricsReporter reporter<BR ALIGN="LEFT"/>- DispatcherConfig config<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ submit(selection, prefixPolicy): SubmissionResult<BR ALIGN="LEFT"/>+ cancelDelivery(delivery): CompletionStage&lt;Result&gt;<BR ALIGN="LEFT"/>- prepare(delivery): PrepareResult<BR ALIGN="LEFT"/>- commit(delivery): CommitResult<BR ALIGN="LEFT"/>- send(delivery): void<BR ALIGN="LEFT"/>- publishRoutes(delivery): void<BR ALIGN="LEFT"/>- onResponse(delivery, reply): void<BR ALIGN="LEFT"/>- onFailure(delivery, failure): void<BR ALIGN="LEFT"/>+ bindLifecycle(lifecycle): void [启动前一次]<BR ALIGN="LEFT"/>+ cancelRemote(target, attemptId): CompletionStage&lt;CancelReply&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"DeliveryExecution" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>DeliveryExecution</B><BR/>class · 350 LOC</TD></TR><TR><TD ALIGN="LEFT">- ExecutorService workers<BR ALIGN="LEFT"/>- CapacityCounter admission<BR ALIGN="LEFT"/>- Set&lt;OperationId&gt; inFlight<BR ALIGN="LEFT"/>- BatchIdGenerator ids<BR ALIGN="LEFT"/>- boolean accepting<BR ALIGN="LEFT"/>- final ExecutorStats statistics<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ tryReserve(): DeliveryPermit<BR ALIGN="LEFT"/>+ execute(delivery, work): void<BR ALIGN="LEFT"/>+ nextBatchId(): long<BR ALIGN="LEFT"/>+ stopAdmission(): void<BR ALIGN="LEFT"/>+ awaitIdle(deadline): boolean<BR ALIGN="LEFT"/>+ stats(): ExecutorStats<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PrefillEndpoint" -> "WorkerEndpoint" [arrowhead=empty, label=""];
"DecodeEndpoint" -> "WorkerEndpoint" [arrowhead=empty, label=""];
"EndpointRegistry" -> "WorkerEndpoint" [dir=both, arrowtail=odiamond, arrowhead=none, label="generation"];
"EndpointRegistry" -> "EndpointStats" [style=dashed, arrowhead=empty, label=""];
"DeliveryDispatcher" -> "Delivery" [dir=both, arrowtail=odiamond, arrowhead=none, label="一次投递"];
"DeliveryDispatcher" -> "DeliveryExecution" [style=dashed, arrowhead=vee, label="设施"];
"DeliveryDispatcher" -> "PrefillEndpoint" [style=dashed, arrowhead=vee, label="预留 / 提交"];
"DeliveryDispatcher" -> "DecodeEndpoint" [style=dashed, arrowhead=vee, label="精确资源操作"];
}