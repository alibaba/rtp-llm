digraph G {
graph [rankdir=LR, bgcolor="transparent", nodesep=0.3, ranksep=0.65, pad=0.15];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=10, color="#64748b"];
"RequestContext" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>RequestContext</B><BR/>class · 650 LOC</TD></TR><TR><TD ALIGN="LEFT">- final Request input<BR ALIGN="LEFT"/>- final long generation<BR ALIGN="LEFT"/>- RequestRoute route<BR ALIGN="LEFT"/>- Cancellation cancellation<BR ALIGN="LEFT"/>- SendState sendState<BR ALIGN="LEFT"/>- long deliveryId<BR ALIGN="LEFT"/>- Response selectedResponse<BR ALIGN="LEFT"/>- ReleaseProgress released<BR ALIGN="LEFT"/>- Deadlines deadlines<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ snapshot(): Snapshot<BR ALIGN="LEFT"/>+ cancel(reason, now): boolean<BR ALIGN="LEFT"/>+ beginDelivery(route, deliveryId, now): boolean<BR ALIGN="LEFT"/>+ recordDeliveryResult(deliveryId, result): boolean<BR ALIGN="LEFT"/>+ selectResponse(response): boolean<BR ALIGN="LEFT"/>+ markResourcesReleased(role, identity): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RequestLifecycle" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>RequestLifecycle</B><BR/>class · 850 LOC</TD></TR><TR><TD ALIGN="LEFT">- RequestRepository requests<BR ALIGN="LEFT"/>- RequestScheduler scheduler<BR ALIGN="LEFT"/>- DeliveryDispatcher dispatcher<BR ALIGN="LEFT"/>- ExpirationTimer expiration<BR ALIGN="LEFT"/>- ResponseCompletionExecutor responses<BR ALIGN="LEFT"/>- RequestTaskPool tasks<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ submit(ctx): CompletionStage&lt;Response&gt;<BR ALIGN="LEFT"/>+ cancel(requestId, reason): RequestState<BR ALIGN="LEFT"/>+ onTimeout(ctx, token): void<BR ALIGN="LEFT"/>+ onDeliveryResult(ctx, deliveryId, result): void<BR ALIGN="LEFT"/>+ onEngineStatus(identity, status): void<BR ALIGN="LEFT"/>+ settle(ctx): void<BR ALIGN="LEFT"/>+ stopAdmission(): void<BR ALIGN="LEFT"/>+ awaitSettled(deadline): boolean<BR ALIGN="LEFT"/>+ bind(scheduler, dispatcher): void [启动前一次]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RequestRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>RequestRepository</B><BR/>class · 250 LOC</TD></TR><TR><TD ALIGN="LEFT">- ConcurrentMap&lt;RequestId, RequestContext&gt; active<BR ALIGN="LEFT"/>- BoundedHistory&lt;RequestState&gt; completed<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ register(ctx): boolean<BR ALIGN="LEFT"/>+ find(id): RequestContext<BR ALIGN="LEFT"/>+ isCurrent(ctx): boolean<BR ALIGN="LEFT"/>+ remove(ctx, result): boolean<BR ALIGN="LEFT"/>+ findResult(id): RequestState<BR ALIGN="LEFT"/>+ snapshot(): List&lt;RequestContext&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RequestRoute" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>RequestRoute</B><BR/>class · 200 LOC</TD></TR><TR><TD ALIGN="LEFT">- final RequestContext context<BR ALIGN="LEFT"/>- final long routeId<BR ALIGN="LEFT"/>- final PrefillEndpoint prefill<BR ALIGN="LEFT"/>- final DecodeEndpoint decode<BR ALIGN="LEFT"/>- final Reservation prefillReservation<BR ALIGN="LEFT"/>- final Reservation decodeReservation<BR ALIGN="LEFT"/>- final Use[] endpointUses<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ context(): RequestContext<BR ALIGN="LEFT"/>+ identity(): RouteIdentity<BR ALIGN="LEFT"/>+ planningInput(): QueueItem<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RequestState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#ecf8ef"><B>RequestState</B><BR/>record · 100 LOC</TD></TR><TR><TD ALIGN="LEFT">+ requestId: long<BR ALIGN="LEFT"/>+ generation: long<BR ALIGN="LEFT"/>+ phase: Phase<BR ALIGN="LEFT"/>+ reason: String<BR ALIGN="LEFT"/>+ response: Response<BR ALIGN="LEFT"/>+ updatedAt: long<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RequestScheduler" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#e6f2ff"><B>RequestScheduler</B><BR/>interface · 50 LOC</TD></TR><TR><TD ALIGN="LEFT">+ start(): void<BR ALIGN="LEFT"/>+ schedule(): void<BR ALIGN="LEFT"/>+ onRequest(ctx): void<BR ALIGN="LEFT"/>+ onRequestChanged(ctx): void<BR ALIGN="LEFT"/>+ onEndpointChanged(endpoint): void<BR ALIGN="LEFT"/>+ stop(): void<BR ALIGN="LEFT"/>+ awaitStopped(deadlineNanos): boolean<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"DirectRequestScheduler" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>DirectRequestScheduler</B><BR/>class · 180 LOC</TD></TR><TR><TD ALIGN="LEFT">- RequestWorkerSelector selector<BR ALIGN="LEFT"/>- DeliveryDispatcher dispatcher<BR ALIGN="LEFT"/>- RequestLifecycle lifecycle<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ start(): void<BR ALIGN="LEFT"/>+ onRequest(ctx): void<BR ALIGN="LEFT"/>+ onRequestChanged(ctx): void<BR ALIGN="LEFT"/>+ onEndpointChanged(endpoint): void<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/>+ schedule(): void<BR ALIGN="LEFT"/>+ stop(): void<BR ALIGN="LEFT"/>+ awaitStopped(deadlineNanos): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"QueuedRequestScheduler" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD BGCOLOR="#f3f0ff"><B>QueuedRequestScheduler</B><BR/>class · 850 LOC</TD></TR><TR><TD ALIGN="LEFT">- PlacementQueue queue<BR ALIGN="LEFT"/>- RequestWorkerSelector selector<BR ALIGN="LEFT"/>- GroupPlanner planner<BR ALIGN="LEFT"/>- DeliveryDispatcher dispatcher<BR ALIGN="LEFT"/>- RequestLifecycle lifecycle<BR ALIGN="LEFT"/>- DecodePreemption preemption<BR ALIGN="LEFT"/>- Map&lt;CapacityKey, Waiters&gt; waiting<BR ALIGN="LEFT"/>- Set&lt;WorkerEndpoint&gt; ready<BR ALIGN="LEFT"/>- Set&lt;PlanId&gt; inFlight<BR ALIGN="LEFT"/>- ExecutorService planners [复用现有池]<BR ALIGN="LEFT"/>- Thread schedulerThread [移入原有调度线程]<BR ALIGN="LEFT"/>- long nextCheck<BR ALIGN="LEFT"/>- AtomicLong notifications<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ start(): void<BR ALIGN="LEFT"/>+ onRequest(ctx): void<BR ALIGN="LEFT"/>+ onRequestChanged(ctx): void<BR ALIGN="LEFT"/>+ onEndpointChanged(endpoint): void<BR ALIGN="LEFT"/>- schedulePlacement(now): void<BR ALIGN="LEFT"/>- scheduleDelivery(endpoint, now): void<BR ALIGN="LEFT"/>- onSubmissionResult(result): void<BR ALIGN="LEFT"/>+ close(): void<BR ALIGN="LEFT"/>- requestRun(): void<BR ALIGN="LEFT"/>+ schedule(): void<BR ALIGN="LEFT"/>+ stop(): void<BR ALIGN="LEFT"/>+ awaitStopped(deadlineNanos): boolean<BR ALIGN="LEFT"/>- run(): void [调用 schedule 并按期限等待]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RequestLifecycle" -> "RequestContext" [style=dashed, arrowhead=vee, label="状态转换"];
"RequestLifecycle" -> "RequestRepository" [style=dashed, arrowhead=vee, label="精确身份"];
"RequestLifecycle" -> "RequestScheduler" [style=dashed, arrowhead=vee, label="通知"];
"RequestContext" -> "RequestRoute" [dir=both, arrowtail=odiamond, arrowhead=none, label="当前路由"];
"RequestRepository" -> "RequestState" [style=dashed, arrowhead=vee, label="归档结果"];
"DirectRequestScheduler" -> "RequestScheduler" [style=dashed, arrowhead=empty, label=""];
"QueuedRequestScheduler" -> "RequestScheduler" [style=dashed, arrowhead=empty, label=""];
}