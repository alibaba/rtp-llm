    "before": 4604,
    "after": 4620,
    "net_change": 16,
    "BalanceContext_before": 2306,
    "BalanceContext_after": 1944,
    "note": "Moving responsibilities is not counted as deleted implementation."
  },
  "removed_context_workflows": [
    "acceptPrefillStatus",
    "applyPrefillStatusLocked",
    "acceptDecodeStatus",
    "settleAdmissionLocked",
    "decideInactivityLocked",
    "processRequestEndLocked",
    "processPendingEventsUnderPreemptionLocked",
    "finishPreemptedRequestLocked",
    "acknowledgeDeliveryLocked"
  ],
  "convergence": [
    "Decode allocation and pending preemption facts share advanceAfterDecodeReconciliationLocked after exact ledger reconciliation.",
    "Prefill and preemption capacity publication share one outside-context continuation with unchanged failure ordering.",
    "Context no longer calls Scheduler to construct effects or Endpoint to query/update ledgers."
  ],
  "naming": {
    "VictimTerminal": "VictimResolution",
    "terminalObservation": "requestResolution",
    "note": "Request-side resolution may mean finalized or resumed delivery. Cancel ACK and Decode release proof remain separate."
  },
  "retained_contracts": [
    "Old route/generation callbacks are fenced by exact identity.",
    "Authoritative Worker terminal precedence is unchanged.",
    "NOT_FOUND does not prove resource release; actual allocation and exact Decode reconciliation are still required.",
    "Cleanup with retained terminal keeps its finished claim until request resolution publication.",
    "Delivery ACK does not overwrite a newer selected terminal response.",
    "RUN_AGAIN preserves facts received while cleanup is running.",
    "Resource reconciliation keeps Context -> Decode State lock order; capacity notifications and Future completion occur outside Context.",
    "Failed or empty candidate captures do not advance the routing cursor.",
    "Address ring fairness across dynamic candidate sets/groups and concurrent selection remains linearizable."
  ],
