    "baseline_commit": "7180432a690daef1a28a79a8024890dac0d73a60",
    "scope": "Finish delivery fact/execution separation and remove redundant publication wrapper and request-wide selector dependencies.",
    "removed": [
      "DeliveryClaim.completion callback",
