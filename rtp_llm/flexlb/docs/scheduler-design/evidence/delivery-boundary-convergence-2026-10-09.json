    "ownership": {
      "BalanceContext.DeliveryClaim": "Exact sender, abandonment and release facts. Fact methods do not start RPC, submit continuations or complete the settlement barrier.",
      "AbstractRequestScheduler": "Final send checks, delivery results, abandonment, cleanup ACK consumption and settlement. Local cleanup is queued before completing the settlement barrier.",
      "DeliveryCleanupTask": "Cancel RPC attempt, timeout and retry protocol; exact late ACKs are returned to the scheduler.",
      "EndpointRegistry": "Publish the initialized WorkerEndpoint directly; existing-generation status notifications still run after unlocking.",
      "CostBasedPrefillStrategy": "Read frozen RequestRequirements and startup configuration without receiving the mutable request context."
    },
    "preserved": [
      "Cancel ACK and actual resource-release proof remain distinct.",
      "Sender exit alone cannot prove that no request was sent.",
      "Old context/route/reservation events cannot affect a replacement registration.",
      "Queued Prefill victim selection and atomic replacement retain the shared ownership lock.",
      "Selection still evaluates the full live fleet and preserves thread-local projection reuse."
