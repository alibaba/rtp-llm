    "script": "#!/bin/sh\nset -eu\nexport JAVA_HOME=/opt/flexlb-jdk21-20261002\nexport PATH=\"$JAVA_HOME/bin:$PATH\"\nexport MAVEN_OPTS=\"-Duser.home=/data0/luoli.hn/data0 -Dmaven.repo.local=/data0/luoli.hn/data0/.m2/repository\"\ncd /data0/luoli.hn/data0/work/rtp_llm_4/github-opensource/rtp_llm/flexlb\nout=/tmp/flexlb-status-flow-20261007\nmkdir -p \"$out\"\n{ date -Iseconds; uname -a; java -version; getconf _NPROCESSORS_ONLN; free -g; uptime; } > \"$out/environment.txt\" 2>&1\nfor module in flexlb-common flexlb-cache flexlb-grpc flexlb-sync flexlb-api flexlb-mock-engine; do\n rm -rf \"$module/target/classes\" \"$module/target/test-classes\"\ndone\nrm -rf flexlb-grpc/target/generated-sources/protobuf flexlb-grpc/target/proto-java\npython3 /tmp/flexlb-status-flow-20261007/check-seal.py > \"$out/source-before.sha256\"\ntimeout --kill-after=15s 900s ./mvnw -B -P 'opensource,!internal' -pl flexlb-sync -am test > \"$out/remote-ut.log\" 2>&1\nvmstat -w -t 1 > \"$out/vmstat.log\" &\nobserver=$!\ntrap 'kill \"$observer\" 2>/dev/null || true' EXIT\nstatus=0\nfor mode in BATCH NON_BATCH; do\n decision=FIXED_WINDOW\n if [ \"$mode\" = NON_BATCH ]; then decision=SINGLE; fi\n set +e\n timeout --kill-after=15s 900s ./mvnw -B -P 'opensource,!internal,api-performance-regression' -pl flexlb-api -am \\\n '-Dtest=MasterBatchEndToEndPerformanceTest#masterMeetsRateSloAcrossEngineScaleMatrix' \\\n -DfailIfNoTests=false -Dsurefire.failIfNoSpecifiedTests=false \\\n -Dflexlb.perf.heap=64g \"-Dflexlb.perf.delivery-mode=$mode\" \"-Dflexlb.perf.decision-mode=$decision\" \\\n -Dflexlb.perf.engine-matrix-topologies=750x750 -Dflexlb.perf.engine-matrix-target-qps=3000,10000 \\\n -Dflexlb.perf.engine-matrix-duration-ms=10000 -Dflexlb.perf.engine-matrix-warmup-ms=10000 \\\n -Dflexlb.perf.engine-matrix-warmup-requests-per-prefill=16 \\\n -Dflexlb.perf.engine-matrix-min-qps-ratio=0.98 \\\n -Dflexlb.perf.engine-matrix-max-server-p99-ms=50 \\\n -Dflexlb.perf.engine-matrix-max-client-p99-ms=50 \\\n -Dflexlb.perf.engine-matrix-max-batch-wait-p99-ms=50 \\\n test > \"$out/$mode.log\" 2>&1\n result=$?\n set -e\n echo \"$result\" > \"$out/$mode.exit\"\n if [ \"$result\" -ne 0 ]; then status=1; fi\n report=flexlb-api/target/surefire-reports/TEST-org.flexlb.httpserver.MasterBatchEndToEndPerformanceTest.xml\n if [ -f \"$report\" ]; then cp \"$report\" \"$out/$mode.xml\"; fi\n awk '/FlexLB offered traffic:|FlexLB client latency:|FlexLB Master engine-scale E2E:|\\[ERROR\\]|BUILD SUCCESS|BUILD FAILURE/' \"$out/$mode.log\"\ndone\npython3 /tmp/flexlb-status-flow-20261007/check-seal.py > \"$out/source-after.sha256\"\necho \"$status\" > \"$out/matrix.exit\"\nexit \"$status\"\n"
