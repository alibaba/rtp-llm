# RTP-LLM's single dependency declaration surface (Bazel 7.7.1, Bzlmod-only).
# BCR modules live here; all non-BCR deps are created by the rtp_non_module_deps
# extension (deps/extensions/defs.bzl), derived from deps.json.
module(
    name = "rtp_llm",
    version = "0.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_python", version = "0.33.2")

# Promoted to a direct dep so @platforms is visible to repos created by the non-module
# extension (git_deps.bzl rewrites absl's BUILD to @platforms//{os,cpu}:*, which otherwise
# fails select() resolution there).
bazel_dep(name = "platforms", version = "0.0.10")

# Tarball of commit 084b877c, mirrored in our own public bucket (byte-identical to upstream,
# sha256 verified) to avoid depending on GitHub reachability. Patches have no a/b prefix, hence strip=0.
# Upgrading past 2.0 requires: self-built hubs generating config.bzl, explicit target_platforms
# for the arm hub, and removing the override map wholesale.
archive_override(
    module_name = "rules_python",
    integrity = "sha256-PW/nLxoFazRi8Cr7pQSSEKy67BMQh/sZCC+meSGYqfo=",
    patch_strip = 0,
    patches = [
        "//patches/rules_python:0002-remove-import-from-rules_cc.patch",
        "//patches/rules_python:0001-wheelmaker-store-and-zip64.patch",
        "//patches/rules_python:0003-fail-closed-on-missing-locked-artifact.patch",
    ],
    strip_prefix = "rules_python-084b877c98b580839ceab2b071b02fc6768f3de6",
    urls = ["https://rtp-opensource.oss-cn-hangzhou.aliyuncs.com/archives/github.com/bazelbuild/rules_python/084b877c98b580839ceab2b071b02fc6768f3de6.tar.gz"],
)

# use_repo_rule is kept only for the vendored protobuf below (root-module labels //deps:* reach deps/ directly).
local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

# Vendored protobuf at 3rdparty/protobuf. Declared at MODULE top level because
# native.local_repository is illegal inside a module_extension and relative paths
# inside extensions do not resolve to the main repo root.
local_repository(
    name = "com_google_protobuf",
    path = "3rdparty/protobuf",
)

# Non-BCR archive repos + autoconfig + injection points are all created by this one extension.
# The use_repo list is maintained by `scripts/rtpcli bazel mod-tidy`.
rtp_non_module_deps = use_extension("//deps/extensions:defs.bzl", "rtp_non_module_deps")
use_repo(
