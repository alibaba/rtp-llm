# conda310 python toolchain (defined in root BUILD); the python version is declared once,
# via the python_version flag in .bazelrc.
register_toolchains("//:python310_toolchain")

# 6 pip hubs; hub/lock/interpreter/index and the self-supply set are pinned to deps.json
# profiles by deps/check_module_pip.py (MODULE.bazel cannot load(), so the duplication can
# only be validated).
# The primary index must be aliyun: rules_python 0.33.2 takes "the first readable page" per
# package and never merges indexes, so our partial mirror as primary would shadow complete
# aliyun pages. Exclusively self-supplied packages are pointed back to their flavor view via
# experimental_index_url_overrides.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# ninja's executable lives in the wheel's .data/scripts (installed to bin/, no entry_points),
# but rules_python's spoke BUILD only globs site-packages/**, so bin/ninja is unreachable.
# flashinfer's JIT backend invokes `ninja` via subprocess, so append a filegroup exposing bin/
# to each hub whose lock contains ninja (cpu/arm do not, see deps.json exceptions).
NINJA_BIN_BUILD_CONTENT = """\
filegroup(
    name = "bin",
    srcs = glob(["bin/**"], allow_empty = True),
    visibility = ["//visibility:public"],
)
"""

[
    pip.whl_mods(
        additive_build_content = NINJA_BIN_BUILD_CONTENT,
        # data is merged into the spoke's py_library(pkg) data, so //rtp_llm:ninja
        # dependents carry bin/ninja (referencing :bin directly is unreachable).
        data = [":bin"],
        hub_name = hub,
        whl_name = "ninja",
    )
    for hub in [
        "ninja_bin_cuda12",
        "ninja_bin_cuda12_9",
        "ninja_bin_cuda12_arm",
        "ninja_bin_rocm",
    ]
]

