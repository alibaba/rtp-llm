diff --git python/private/pypi/whl_library.bzl python/private/pypi/whl_library.bzl
--- python/private/pypi/whl_library.bzl
+++ python/private/pypi/whl_library.bzl
@@ -304,9 +304,14 @@
         if not rctx.delete("whl_file.json"):
             fail("failed to delete the whl_file.json file")
 
-    if rctx.attr.whl_patches:
+    whl_patches = dict(rctx.attr.whl_patches)
+    if rctx.attr.annotation:
+        annotation = json.decode(rctx.read(rctx.attr.annotation))
+        for patch_label, patch_args in annotation.get("whl_patches", {}).items():
+            whl_patches[Label(patch_label)] = patch_args
+    if whl_patches:
         patches = {}
-        for patch_file, json_args in rctx.attr.whl_patches.items():
+        for patch_file, json_args in whl_patches.items():
             patch_dst = struct(**json.decode(json_args))
             if whl_path.basename in patch_dst.whls:
                 patches[patch_file] = patch_dst.patch_strip
