+def _host_platform_pip_args(extra_pip_args: List[str]) -> List[str]:
+    """Drops target-only args before building a pure-Python sdist on the host."""
+    target_options = ("--abi", "--implementation", "--platform", "--python-version")
+    result = []
+    skip_value = False
+    for arg in extra_pip_args:
+        if skip_value:
+            skip_value = False
+            continue
+        if arg in target_options:
+            skip_value = True
+            continue
+        if any(arg.startswith(option + "=") for option in target_options):
+            continue
+        if arg == "--only-binary=:all:":
+            continue
+        result.append(arg)
+    return result
+
+
+def _target_platform_matches_host(extra_pip_args: List[str]) -> bool:
+    target_platforms = []
+    read_platform_value = False
+    for arg in extra_pip_args:
+        if read_platform_value:
+            target_platforms.append(arg)
+            read_platform_value = False
+        elif arg == "--platform":
+            read_platform_value = True
+        elif arg.startswith("--platform="):
+            target_platforms.append(arg.split("=", 1)[1])
+
+    if not target_platforms:
+        return True
+    host_arch = platform.machine().lower() or "x86_64"
+    aliases = {
+        "amd64": "x86_64",
+        "arm64": "aarch64",
+    }
+    host_arch = aliases.get(host_arch, host_arch)
+    return any(host_arch in target for target in target_platforms)
+
+
+def _require_pure_python_wheel(whl: Path) -> None:
+    _, _, _, tags = parse_wheel_filename(whl.name)
+    if not tags or any(tag.abi != "none" or tag.platform != "any" for tag in tags):
+        raise RuntimeError(
+            "cross-platform sdist fallback produced a platform-specific wheel: %s" % whl.name
+        )
+
