+namespace {
+struct InitialHandshakeBatch {
+    std::atomic<uint32_t> completed{0};
+    std::atomic<uint32_t> failed{0};
+};
+
+class InitialHandshakeCallback final: public RdmaClientConnectionCallback {
+public:
+    InitialHandshakeCallback(const std::shared_ptr<RdmaClientHostConnections>& pool,
+                             const std::shared_ptr<InitialHandshakeBatch>& batch):
+        RdmaClientConnectionCallback(pool), batch_(batch) {}
+
+    void OnConnectSuccess(const std::shared_ptr<::accl::barex::XConnection>& connection) override {
+        RdmaClientConnectionCallback::OnConnectSuccess(connection);
+        if (!settled_.exchange(true)) {
+            ++batch_->completed;
+        }
+    }
+
+    void OnConnectFailed(const std::shared_ptr<::accl::barex::XConnection>& connection) override {
+        RdmaClientConnectionCallback::OnConnectFailed(connection);
+        // The same callback also reports a disconnect after a successful
+        // connection. That event must not become an initial-handshake retry.
+        if (!settled_.exchange(true)) {
+            ++batch_->failed;
+            ++batch_->completed;
+        }
+    }
+
+private:
+    std::shared_ptr<InitialHandshakeBatch> batch_;
+    std::atomic<bool> settled_{false};
+};
+}  // namespace
