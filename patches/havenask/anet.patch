diff --git aios/network/anet/iocomponent.cpp aios/network/anet/iocomponent.cpp
--- aios/network/anet/iocomponent.cpp
+++ aios/network/anet/iocomponent.cpp
@@ -170,0 +171,47 @@
+void IOComponent::beginApplicationRequest(int idleMs) {
+    if (idleMs <= 0) {
+        return;
+    }
+    MutexGuard guard(&_mutex);
+    if (_state != ANET_CONNECTED) {
+        return;
+    }
+    _requestAwareIdleMs.store(idleMs, std::memory_order_relaxed);
+    ++_outstandingResponses;
+    _acceptedReadGeneration = _readGeneration;
+    setMaxIdleTime(-1);
+}
+
+void IOComponent::completePostedResponses(size_t count) {
+    if (count == 0) {
+        return;
+    }
+    MutexGuard guard(&_mutex);
+    if (_requestAwareIdleMs.load(std::memory_order_relaxed) == 0 || count > _outstandingResponses) {
+        return;
+    }
+    _outstandingResponses -= count;
+    if (_outstandingResponses == 0 && !_parsingInboundBytes && _state == ANET_CONNECTED &&
+        _acceptedReadGeneration == _readGeneration) {
+        _lastUseTime = TimeUtil::getTime();
+        setMaxIdleTime(_requestAwareIdleMs.load(std::memory_order_relaxed));
+    }
+}
+
+void IOComponent::noteInboundBytesLocked() {
+    _parsingInboundBytes = true;
+    if (_requestAwareIdleMs.load(std::memory_order_relaxed) != 0) {
+        ++_readGeneration;
+        setMaxIdleTime(-1);
+    }
+}
+
+void IOComponent::finishInboundParseLocked() {
+    _parsingInboundBytes = false;
+    if (_requestAwareIdleMs.load(std::memory_order_relaxed) != 0 && _outstandingResponses == 0 &&
+        _state == ANET_CONNECTED && _acceptedReadGeneration == _readGeneration) {
+        _lastUseTime = TimeUtil::getTime();
+        setMaxIdleTime(_requestAwareIdleMs.load(std::memory_order_relaxed));
+    }
+}
+
diff --git aios/network/anet/iocomponent.h aios/network/anet/iocomponent.h
