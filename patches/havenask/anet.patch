@@ -18,0 +19 @@
+#include <atomic>
@@ -169 +170,13 @@
-    inline void updateUseTime(int64_t now) { _lastUseTime = now; }
+    // Legacy transport activity updates are ignored for opt-in HTTP connections.
+    // Their idle interval starts only after the final response is posted.
+    inline void updateUseTime(int64_t now) {
+        if (_requestAwareIdleMs.load(std::memory_order_relaxed) == 0) {
+            _lastUseTime = now;
+        }
+    }
+
+    void beginApplicationRequest(int idleMs);
+    void completePostedResponses(size_t count);
+    // Called by TCPConnection::readData while the component mutex is held.
+    void noteInboundBytesLocked();
+    void finishInboundParseLocked();
@@ -284,0 +298,7 @@
+    // Only this opt-in flag is read by the I/O worker without _mutex. The
+    // remaining application-idle state is protected by _mutex.
+    std::atomic<int> _requestAwareIdleMs{0};
+    size_t _outstandingResponses{0};
+    uint64_t _readGeneration{0};
+    uint64_t _acceptedReadGeneration{0};
+    bool _parsingInboundBytes{false};
