@@ -50,6 +50,35 @@

 const string &MetricsRecord::Name() const { return info_->Name(); }

+void MetricsRecord::OverrideTags(const map<string, string> &tags, const std::set<string> &keys) {
+    const auto &current = tags_->GetTagsMap();
+    bool changed = false;
+    for (const auto &key : keys) {
+        auto oldTag = current.find(key);
+        auto newTag = tags.find(key);
+        if (oldTag == current.end() && newTag == tags.end()) {
+            continue;
+        }
+        if (oldTag == current.end() || newTag == tags.end() || oldTag->second != newTag->second) {
+            changed = true;
+            break;
+        }
+    }
+    if (!changed) {
+        return;
+    }
+    auto mergedTags = current;
+    for (const auto &key : keys) {
+        auto tag = tags.find(key);
+        if (tag == tags.end()) {
+            mergedTags.erase(key);
+        } else {
+            mergedTags[key] = tag->second;
+        }
+    }
+    tags_.reset(new MetricsTags(mergedTags));
+}
