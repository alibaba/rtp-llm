+bool MetricsSystem::SetReportingEnabled(bool enabled) {
+    std::lock_guard<std::mutex> reportingLock(reporting_mutex_);
+    std::lock_guard<std::mutex> snapshotLock(snapshot_mutex_);
+    if (reporting_enabled_ == enabled) {
+        return true;
+    }
+    // SendEvent holds the same mutex through Flush: once this returns no
+    // pre-sleep publication can still reach the transport.
+    {
+        std::lock_guard<std::mutex> queueLock(queue_mutex_);
+        decltype(publish_queue_) empty;
+        publish_queue_.swap(empty);
