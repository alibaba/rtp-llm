+    if (!enabled) {
+        reporting_enabled_ = false;
+        // Destruction closes connections and drops the sink's retry queue.
+        sinks_.clear();
+        return true;
+    }
+    // Include every level, not just this tick's levels. Never replay samples
+    // collected during sleep or dilute QPS with the sleep interval.
