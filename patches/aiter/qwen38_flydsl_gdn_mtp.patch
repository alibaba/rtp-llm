+def _mtp_contiguous_reads(indices):
+    # Torch considers singleton views contiguous even with a non-unit stride.
+    # FlyDSL dynamic memrefs require a unit-stride axis; this view preserves
+    # the same single element and adds no device copy on the graph path.
+    result = indices.contiguous()
+    if result.stride(0) != 1:
+        result = result.as_strided(result.shape, (1,))
+    return result
+
+
+def flydsl_gdr_mtp_rtp(query, key, value, a, b, dt_bias, A_log, state, out,
+                       read_indices, write_indices, use_qk_l2norm=True, stream=None):
+    """Chain verify with independent read slots and a checkpoint per candidate."""
+    _mtp_common_checks(query, key, value, a, b, dt_bias, A_log, state, out)
+    _require_index("read_indices", read_indices, query, dims=1)
+    _require_index("write_indices", write_indices, query, dims=2,
+                   layout="[batch, token]", covers=True)
+    _mtp_launch(mode=MTP_MODE_CHAIN, query=query, key=key, value=value,
+                a=a, b=b, dt_bias=dt_bias, A_log=A_log, state=state, out=out,
+                state_indices=write_indices.contiguous(), num_accepted=None,
+                inter_indices=_mtp_contiguous_reads(read_indices), parent_tokens=None,
+                inter_buffer=None, use_qk_l2norm=use_qk_l2norm, min_live_slot=0,
+                has_tree=False, disable_state_update=False,
+                stream=_mtp_stream(query, stream))
+
+
+def flydsl_gdr_mtp_hybrid(q,k,v,a,b,bias,alog,state,out,reads,writes,record):
+    """Save the full-accept state and FP32 records for partial-accept replay."""
+    _mtp_common_checks(q,k,v,a,b,bias,alog,state,out)
+    if state.dtype != torch.float32 or state.shape[-2:] != (128, 128):
+        raise ValueError("Hybrid replay requires FP32 128x128 state")
+    if (record.shape != (*q.shape[:2],v.shape[-2],3,128)
+            or record.dtype != torch.float32 or not record.is_contiguous()
+            or record.device != q.device):
+        raise ValueError("Invalid hybrid replay record buffer")
+    _require_index("reads",reads,q,dims=1)
+    _require_index("writes",writes,q,dims=2,layout="[batch, token]",covers=True)
+    _mtp_launch(mode=MTP_MODE_CHAIN, query=q,key=k,value=v,a=a,b=b,dt_bias=bias,A_log=alog,
+        state=state,out=out,state_indices=writes,num_accepted=None,inter_indices=_mtp_contiguous_reads(reads),parent_tokens=None,
+        inter_buffer=record,use_qk_l2norm=True,min_live_slot=0,has_tree=False,disable_state_update=False,
+        stream=_mtp_stream(q,None),compact_record=True)
