+                a=a, b=b, dt_bias=dt_bias, A_log=A_log, state=state, out=out,
+                state_indices=write_indices.contiguous(), num_accepted=None,
+                inter_indices=read_indices.contiguous(), parent_tokens=None,
+                inter_buffer=None, use_qk_l2norm=use_qk_l2norm, min_live_slot=0,
+                has_tree=False, disable_state_update=False,
+                stream=_mtp_stream(query, stream))
