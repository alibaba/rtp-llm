+template <GatedActivation Activation>
+__device__ __forceinline__ float official_preweighted_activation(
+        float gate, float up, float limit, float activation_alpha,
+        float situ_beta, float situ_linear_beta) {
+    if constexpr (Activation == GatedActivation::SwiGLU) {
+        if (limit >= 0.0f) {
