+// Official DSV4 activation contract: one E4M3 scale per 128 values,
+// stored as FP32 but restricted to the positive UE8M0 (power-of-two) grid.
+template <bool FastMath>
+CUTLASS_DEVICE FP8Scale fp8_block_scale_ue8m0(float amax) {
+    const float raw = fmaxf(amax, 1e-4f) * (1.0f / 448.0f);
+    const uint32_t bits = (__float_as_uint(raw) + 0x007FFFFFu) & 0x7F800000u;
+    const float scale = __uint_as_float(bits);
+    return {scale, math::fp32_divide<FastMath>(1.0f, scale)};
+}
