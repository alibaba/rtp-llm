+def quantize_rows_ue8m0(x):
+    """Official block128 E4M3 quantization with FP32-stored power-of-two scales."""
+    original = x.shape
+    values = x.float().reshape(*original[:-1], -1, 128)
+    raw = values.abs().amax(-1).clamp_min(1e-4) / 448.0
+    scale = torch.pow(2.0, torch.ceil(torch.log2(raw)))
+    q = (values * scale.reciprocal().unsqueeze(-1)).to(torch.float8_e4m3fn).reshape(original)
+    return q, scale
