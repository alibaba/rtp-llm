+    for (int i = 0; i < 4; ++i)
+        amax = fmaxf(amax, fabsf(values[i]));
+    amax = warp_absmax(amax);
+    const float raw = fmaxf(amax, 1e-4f) * (1.0f / 448.0f);
+    const uint32_t bits = (__float_as_uint(raw) + 0x007FFFFFu) & 0x7F800000u;
+    const float sf = __uint_as_float(bits);
+    const float inv_sf = 1.0f / sf;
+    if (lane == 0)
+        *scale = sf;
+    #pragma unroll
+    for (int i = 0; i < 4; ++i)
+        output[lane * 4 + i] = __hg_fp8_e4m3(values[i] * inv_sf);
