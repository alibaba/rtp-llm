+"""Quantize the GDN input and compute the BF16 B/A gates in one small-batch launch."""
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _quant_and_ba_kernel(X, Weight, Quant, Scale, BA, B: tl.constexpr):
+    tile = tl.program_id(0)
+    row = tl.program_id(1)
+    k = tl.arange(0, 4096)
+    x = tl.load(X + row * 2560 + k, k < 2560, 0.).to(tl.float32)
+    if tile == 48 // B:
+        scale = tl.max(tl.abs(x), 0) * (1. / 240.)
+        inv = tl.where(scale > 0., 1. / scale, 0.)
+        # Preserve AITER's FNUZ bytes for zero rows as well as their zero scale.
+        q = tl.where(scale == 0., -240., tl.maximum(-240., tl.minimum(240., x * inv)))
+        tl.store(Quant + row * 2560 + k, q, k < 2560)
+        tl.store(Scale + row, scale)
+    else:
+        n = tile * B + tl.arange(0, B)
+        w = tl.load(Weight + n[:, None] * 2560 + k[None, :], k[None, :] < 2560, 0.).to(tl.float32)
+        tl.store(BA + row * 48 + n, tl.sum(w * x[None, :], 1))
+
+
+def quant_and_ba(x, weight):
+    rows = x.shape[0]
+    q = torch.empty_like(x, dtype=torch.float8_e4m3fnuz)
+    scale = x.new_empty((rows, 1), dtype=torch.float32)
+    ba = x.new_empty((rows, 48))
+    block, warps = (1, 8) if rows == 4 else (2, 4)
+    _quant_and_ba_kernel[(48 // block + 1, rows)](x, weight, q, scale, ba, block, num_warps=warps)
+    return (q, scale), ba
