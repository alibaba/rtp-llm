+"""Small-batch Qwen4 HC up projection and residual gating for ROCm target verify."""
+import torch
+import triton
+import triton.language as tl
+
+
+def pack_verify_weight(weight):
+    """Interleave the four streams of each hidden channel for one MFMA tile."""
+    from aiter.ops.quant import per_token_quant_hip
+
+    quant, scales = per_token_quant_hip(weight.detach().contiguous(), quant_dtype=torch.float8_e4m3fnuz)
+
+    def interleave(tensor):
+        return tensor.reshape(4, 2560, -1).transpose(0, 1).contiguous().view_as(tensor)
+
+    return interleave(quant), interleave(scales)
+
+
+@triton.jit
+def _packed_hc_up_kernel(Gate, Weight, Scale, Normed, Output, ROWS: tl.constexpr):
+    rows = tl.arange(0, 16)
+    columns = tl.program_id(0) * 64 + tl.arange(0, 64)
+    k = tl.arange(0, 512)
+    gate = tl.load(Gate + rows[:, None] * 320 + k[None, :],
+                   (rows[:, None] < ROWS) & (k[None, :] < 320), 0.).to(tl.float32)
+    weight = tl.load(Weight + columns[:, None] * 320 + k[None, :], k[None, :] < 320, 0.)
+    scale = tl.max(tl.abs(gate), 1) / 240.
+    quant = (gate * tl.where(scale > 0, 1. / scale, 0.)[:, None]).to(tl.float8e4b8)
+    projection = tl.dot(quant, tl.trans(weight)) * scale[:, None] * tl.load(Scale + columns)[None, :]
+    residual_cols = (columns % 4) * 2560 + columns // 4
+    residual = tl.load(Normed + rows[:, None] * 10240 + residual_cols[None, :],
+                       rows[:, None] < ROWS, 0.).to(tl.float32)
+    gated = residual * tl.sigmoid(projection.to(tl.bfloat16).to(tl.float32))
+    mixed = tl.sum(tl.reshape(gated, (16, 16, 4)), 2) * 0.25
+    tl.store(Output + rows[:, None] * 2560 + tl.program_id(0) * 16 + tl.arange(0, 16)[None, :],
+             mixed, rows[:, None] < ROWS)
+
+
+def verify_gated_mean(normed, gate, packed, quant_dtype):
+    from aiter.ops.quant import per_token_quant_hip
+
+    mixed = normed.new_empty((gate.shape[0], 2560))
+    _packed_hc_up_kernel[(160,)](gate, *packed, normed, mixed, gate.shape[0], num_warps=4)
+    quantized = per_token_quant_hip(mixed, quant_dtype=quant_dtype) if quant_dtype is not None else None
+    return mixed, quantized
