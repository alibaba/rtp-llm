+"""Qwen4 gated down projection for the MI308X PD decode verifier."""
+import ctypes
+import os
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+from atom.model_ops.qwen38_moe_dispatch import rtp_single_verify
+from atom.utils import is_mi308x
+from atom.model_ops.qwen4_exp.hc_verify_triton import split_project, finalize
+
+
+@lru_cache(None)
+def _load_kernel(device):
+    hip = ctypes.CDLL("libamdhip64.so")
+    ptr = ctypes.c_void_p
+    hip.hipModuleLoad.argtypes = [ctypes.POINTER(ptr), ctypes.c_char_p]
+    hip.hipModuleGetFunction.argtypes = [ctypes.POINTER(ptr), ptr, ctypes.c_char_p]
+    hip.hipModuleLaunchKernel.argtypes = [
+        ptr, *([ctypes.c_uint] * 7), ptr, ctypes.POINTER(ptr), ctypes.POINTER(ptr)
+    ]
+    module, func = ptr(), ptr()
+    with torch.cuda.device(device):
+        path = Path(__file__).with_name("hc_verify.hsaco")
+        status = hip.hipModuleLoad(ctypes.byref(module), os.fsencode(path))
+        if not status:
+            status = hip.hipModuleGetFunction(ctypes.byref(func), module, b"hc_4_256_2")
+        if status:
+            raise RuntimeError(f"HC verifier kernel load failed with HIP status {status}")
+    return hip, module, func
+
+
+def try_project(x, weight, rank, hc_count):
+    rows = x.shape[0]
+    if not (
+        rtp_single_verify.get() and rank == 320 and hc_count == 4
+        and rows in (4, 8, 16, 32, 64) and x.shape == (rows, 10240) and weight.shape == (324, 10240)
+        and x.dtype == weight.dtype == torch.bfloat16 and x.device == weight.device
+        and x.is_contiguous() and weight.is_contiguous() and is_mi308x(x.device)
+    ):
+        return None
+    gate = x.new_empty((rows, 320))
+    inject = x.new_empty((rows, 4))
+    if rows == 4:
+        hip, _, func = _load_kernel(x.device)
+        ptr = ctypes.c_void_p
+        values = [ptr(t.data_ptr()) for t in (x, weight, gate, inject)]
+        args = (ptr * 4)(*(ctypes.cast(ctypes.byref(v), ptr) for v in values))
+        stream = torch.cuda.current_stream(x.device)
+        status = hip.hipModuleLaunchKernel(func, 324, 2, 1, 256, 1, 1, 0,
+                                           ptr(stream.cuda_stream), args, None)
+        if status:
+            raise RuntimeError(f"HC verifier kernel launch failed with HIP status {status}")
+    else:
+        splits, bn, bk, bm = (32, 32, 64, 16) if rows == 8 else (16, 64, 128, 64 if rows == 64 else 16)
+        partials = torch.empty((splits, rows, 324), device=x.device, dtype=torch.float32)
+        split_project[((324 + bn - 1) // bn, splits, max(1, rows // bm))](x, weight, partials, rows, bn, bk, splits, bm, num_warps=4)
+        finalize[(rows, 6)](partials, gate, inject, rows, splits, splits, num_warps=2)
+    return gate, inject
