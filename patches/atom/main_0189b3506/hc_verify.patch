+#include <hip/hip_runtime.h>
+#include <hip/hip_bfloat16.h>
+#include <math.h>
+using bf=hip_bfloat16;
+using pack=uint4;
+union Vec {pack raw; unsigned short h[8];};
+__device__ __forceinline__ float val(unsigned short b){return __uint_as_float(unsigned(b)<<16);}
+template<int M,int T,int R>
+__device__ void project(const bf* x,const bf* w,bf* gate,bf* raw){
+  constexpr int K=10240,N=324;
+  int col=blockIdx.x, first=blockIdx.y*R, t=threadIdx.x;
+  float acc[R]={};
+  const pack* wt=reinterpret_cast<const pack*>(w+col*K);
+  for(int i=t;i<K/8;i+=T){
+    Vec a;a.raw=wt[i];
+    #pragma unroll
+    for(int row=0;row<R;row++){
+      Vec v;v.raw=reinterpret_cast<const pack*>(x+(first+row)*K)[i];
+      #pragma unroll
+      for(int j=0;j<8;j++) acc[row]=fmaf(val(a.h[j]),val(v.h[j]),acc[row]);
+    }
+  }
+  __shared__ float partial[R][T/64];
+  #pragma unroll
+  for(int r=0;r<R;r++){
+    for(int off=32;off;off>>=1)acc[r]+=__shfl_down(acc[r],off,64);
+    if(!(t%64))partial[r][t/64]=acc[r];
+  }
+  __syncthreads();
+  if(t<R){
+    float sum=0;
+    #pragma unroll
+    for(int i=0;i<T/64;i++)sum+=partial[t][i];
+    bf rounded(sum);
+    if(col<320){
+      float z=float(bf(float(rounded)*0.25f));
+      gate[(first+t)*320+col]=bf(z/(1.f+expf(-z)));
+    }else raw[(first+t)*4+col-320]=rounded;
+  }
+}
+extern "C" __global__ void hc_4_256_2(const bf* x, const bf* weight, bf* gate, bf* inject) {
+  project<4, 256, 2>(x, weight, gate, inject);
+}
