+import triton
+import triton.language as tl
+
+@triton.jit
+def split_project(X,W,P,M:tl.constexpr,BN:tl.constexpr,BK:tl.constexpr,S:tl.constexpr,BM:tl.constexpr):
+    n=tl.program_id(0)*BN+tl.arange(0,BN)
+    m=tl.arange(0,BM)
+    if M > BM:
+        m+=tl.program_id(2)*BM
+    split=tl.program_id(1)
+    k=split*(10240//S)+tl.arange(0,BK)
+    acc=tl.full((BM,BN),0,tl.float32)
+    for i in range((10240//S)//BK):
+        x=tl.load(X+m[:,None]*10240+k[None,:],m[:,None]<M,0)
+        w=tl.load(W+n[None,:]*10240+k[:,None],n[None,:]<324,0)
+        acc=tl.dot(x,w,acc)
+        k+=BK
+    tl.store(P+split*M*324+m[:,None]*324+n[None,:],acc,(m[:,None]<M)&(n[None,:]<324))
+
+@triton.jit
+def finalize(P,G,R,M:tl.constexpr,S:tl.constexpr,BS:tl.constexpr):
+    row=tl.program_id(0)
+    n=tl.program_id(1)*64+tl.arange(0,64)
+    s=tl.arange(0,BS)
+    a=tl.load(P+s[:,None]*M*324+row*324+n[None,:],(s[:,None]<S)&(n[None,:]<324),0)
+    d=tl.sum(a,0).to(tl.bfloat16).to(tl.float32)
+    z=(d*0.25).to(tl.bfloat16).to(tl.float32)
+    tl.store(G+row*320+n,z*tl.sigmoid(z),n<320)
+    tl.store(R+row*4+(n-320),d,(n>=320)&(n<324))
