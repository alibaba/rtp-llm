+@triton.jit
+def _qsa_commit_state_ring_kernel(
+    state_ptr,
+    slots_ptr,
+    raw_ptr,
+    request_ptr,
+    position_ptr,
+    state_stride_page,
+    state_stride_row,
+    raw_stride_row,
+    raw_stride_dim,
+    rows,
+    RING_ROWS: tl.constexpr,
+    HEAD_DIM: tl.constexpr,
+    BLOCK_D: tl.constexpr,
