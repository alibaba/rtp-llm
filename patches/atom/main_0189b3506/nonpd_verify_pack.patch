+"""MI308X top-10 plus shared-expert route packing for TP2 Qwen4 verifiers."""
+import ctypes
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+@lru_cache(None)
+def _load(device):
+    ptr = ctypes.c_void_p
+    hip = ctypes.CDLL("libamdhip64.so")
+    hip.hipModuleLoad.argtypes = [ctypes.POINTER(ptr), ctypes.c_char_p]
+    hip.hipModuleGetFunction.argtypes = [ctypes.POINTER(ptr), ptr, ctypes.c_char_p]
+    hip.hipModuleLaunchKernel.argtypes = [ptr, *([ctypes.c_uint] * 7), ptr, ctypes.POINTER(ptr), ctypes.POINTER(ptr)]
+    mod, fn = ptr(), ptr()
+    with torch.cuda.device(device):
+        status = hip.hipModuleLoad(ctypes.byref(mod), bytes(Path(__file__).with_name("qwen4_pack.hsaco")))
+        if not status:
+            status = hip.hipModuleGetFunction(ctypes.byref(fn), mod, b"qwen4_pack_verify_routes")
+    if status:
+        raise RuntimeError(f"MI308X verifier route kernel load failed: {status}")
+    return hip, mod, fn
+
+def pack(ids, weights, mask, block, live, output):
+    rows = ids.shape[0]
+    options = {"device": ids.device}
+    tiles = (rows * 12 + 514 * block - 12 + block - 1) // block
+    sorted_ids = torch.empty(tiles * block, dtype=torch.int32, **options)
+    sorted_weights = torch.empty_like(sorted_ids, dtype=torch.float32)
+    experts = torch.empty(tiles, dtype=torch.int32, **options)
+    sizes = torch.empty(2, dtype=torch.int32, **options)
+    if output is None:
+        output = torch.empty((rows, 2560), dtype=torch.bfloat16, **options)
+    hip, _, func = _load(ids.device)
+    ptr = ctypes.c_void_p
+    values = [ptr(v.data_ptr()) for v in (ids, weights, mask, sorted_ids, sorted_weights, experts, sizes, output)]
+    values.extend((ctypes.c_int(rows), ctypes.c_int(block), ptr(live.data_ptr() if live is not None else 0)))
+    args = (ptr * len(values))(*(ctypes.cast(ctypes.byref(v), ptr) for v in values))
+    stream = ptr(torch.cuda.current_stream(ids.device).cuda_stream)
+    status = hip.hipModuleLaunchKernel(func, 1 + 5 * rows, 1, 1, 256, 1, 1, 0, stream, args, None)
+    if status:
+        raise RuntimeError(f"MI308X verifier route kernel failed: {status}")
+    return sorted_ids, sorted_weights, experts, sizes, output
