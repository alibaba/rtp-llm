+#include <hip/hip_runtime.h>
+#include <stdint.h>
+// Each local expert has at most one route per token. A 64-bit mask encodes
+// stable token order for up to 64 verifier rows. The dummy expert is masked.
+extern "C" __global__ void qwen4_pack_verify_routes(
+    const int *ids, const float *weights, const int *mask, int *sorted_ids,
+    float *sorted_weights, int *sorted_experts, int *sizes, uint32_t *output,
+    int rows, int block_size, const int *num_local_tokens) {
+  const int thread = threadIdx.x, lane = thread % 64, wave = thread / 64;
+  int valid_rows = num_local_tokens ? *num_local_tokens : rows;
+  if (blockIdx.x) {
+    int i = (blockIdx.x - 1) * 256 + thread;
+    if (i < valid_rows * 1280)
+      output[i] = 0;
+    return;
+  }
+  __shared__ unsigned long long hits[514];
+  __shared__ int expert_offsets[514], wave_tiles[4], wave_experts[4],
+      tile_count, local_expert_count;
+  for (int i = thread; i < 514; i += 256)
+    hits[i] = 0;
+  if (!thread) {
+    tile_count = 0;
+    local_expert_count = 0;
+  }
+  __syncthreads();
+  for (int i = thread; i < valid_rows * 12; i += 256) {
+    int expert = ids[i];
+    if (expert >= 0 && mask[expert])
+      atomicOr(hits + expert, 1ull << (i / 12));
+  }
+  __syncthreads();
+  // Prefix sums map active global experts to padded tiles and local expert IDs.
+  for (int base = 0; base < 514; base += 256) {
+    int expert = base + thread;
+    int expert_tiles =
+        expert < 514 ? (__popcll(hits[expert]) + block_size - 1) / block_size
+                     : 0;
+    int prefix_tiles = expert_tiles;
+    for (int d = 1; d < 64; d *= 2) {
+      int other = __shfl_up(prefix_tiles, d);
+      if (lane >= d)
+        prefix_tiles += other;
+    }
+    auto locals = __ballot(expert < 514 && mask[expert]);
+    int local_id = __popcll(locals & ((1ull << lane) - 1));
+    if (lane == 63) {
+      wave_tiles[wave] = prefix_tiles;
+      wave_experts[wave] = __popcll(locals);
+    }
+    __syncthreads();
+    int first = tile_count + prefix_tiles - expert_tiles,
+        l = local_expert_count + local_id;
+    for (int i = 0; i < wave; i++) {
+      first += wave_tiles[i];
+      l += wave_experts[i];
+    }
+    if (expert < 514)
+      expert_offsets[expert] = first * block_size;
+    for (int tile = 0; tile < expert_tiles; tile++)
+      sorted_experts[first + tile] = l;
+    __syncthreads();
+    if (!thread) {
+      for (int i = 0; i < 4; i++) {
+        tile_count += wave_tiles[i];
+        local_expert_count += wave_experts[i];
+      }
+    }
+    __syncthreads();
+  }
+  // Match the Opus ABI, including the valid-row sentinel in padding.
+  if (!thread) {
+    sizes[0] = tile_count * block_size;
+    sizes[1] = valid_rows;
+  }
+  for (int i = thread; i < tile_count * block_size; i += 256) {
+    sorted_ids[i] = (12 << 24) | valid_rows;
+    sorted_weights[i] = 0;
+  }
+  __syncthreads();
+  for (int i = thread; i < valid_rows * 12; i += 256) {
+    int expert = ids[i], row = i / 12;
+    if (expert >= 0 && mask[expert]) {
+      int dest =
+          expert_offsets[expert] + __popcll(hits[expert] & ((1ull << row) - 1));
+      sorted_ids[dest] = ((i % 12) << 24) | row;
+      sorted_weights[dest] = weights[i];
+    }
+  }
+}
