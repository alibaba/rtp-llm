+"""MI308X Qwen4 verifier route layout consumed by the sorted FlyDSL GEMMs."""
+import ctypes
+import logging
+import os
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+from aiter import ActivationType, QuantType
+
+from atom.model_ops.qwen38_moe_dispatch import maybe_small_decode, rtp_single_verify
+from atom.model_ops.topK import topk_meta_rows
+from atom.plugin.prepare import is_rtpllm
+from atom.utils import is_mi308x
+from atom.utils.forward_context import pass_scheduled_tokens_gpu
+
+_ENABLED = os.environ.get("ATOM_RTP_TOPK512", "1") == "1"
+_ptr = ctypes.c_void_p
+
+
+def _check(status):
+    if status:
+        raise RuntimeError(f"Qwen4 verifier route HIP error {status}")
+
+
+@lru_cache(None)
+def _kernel(device, rows):
+    hip = ctypes.CDLL("libamdhip64.so")
+    hip.hipModuleLoad.argtypes = [ctypes.POINTER(_ptr), ctypes.c_char_p]
+    hip.hipModuleGetFunction.argtypes = [ctypes.POINTER(_ptr), _ptr, ctypes.c_char_p]
+    hip.hipModuleLaunchKernel.argtypes = [_ptr, *([ctypes.c_uint] * 7), _ptr,
+                                          ctypes.POINTER(_ptr), ctypes.POINTER(_ptr)]
+    module, function = _ptr(), _ptr()
+    symbol = f"qwen4_verify_route_m{rows}"
+    binary = Path(__file__).with_name("qwen4_verify_route.hsaco" if rows == 4 else symbol + ".hsaco")
+    with torch.cuda.device(device):
+        _check(hip.hipModuleLoad(ctypes.byref(module), os.fsencode(binary)))
+        _check(hip.hipModuleGetFunction(ctypes.byref(function), module, symbol.encode("ascii")))
+    logging.getLogger(__name__).info("Loaded Qwen4 M=%d fused verify routing on %s", rows, device)
+    return hip, module, function
+
+
+def prepare_flydsl_routes(logits, topk_ids, expert_mask):
+    # At most one 16-row tile per selected expert for these four- and eight-row verifier graphs.
+    rows, topk = topk_ids.shape
+    device = logits.device
+    tiles = rows * topk
+    tokens = torch.empty(tiles * 16, device=device, dtype=torch.int32)
+    weights = torch.empty_like(tokens, dtype=torch.float32)
+    experts = torch.empty(tiles, device=device, dtype=torch.int32)
+    sizes = torch.empty(2, device=device, dtype=torch.int32)
+    output = torch.empty((rows, 2560), device=device, dtype=torch.bfloat16)
+    valid = pass_scheduled_tokens_gpu(rows)
+    hip, _, function = _kernel(device, rows)
+    tensors = (logits, topk_ids, expert_mask, tokens, weights, experts, sizes, output, valid)
+    values = [_ptr(t.data_ptr()) if t is not None else _ptr() for t in tensors]
+    args = (_ptr * len(values))(*(ctypes.cast(ctypes.byref(p), _ptr) for p in values))
+    # One routing CTA followed by 40 CTAs that clear the GEMM2 accumulation buffer.
+    stream = torch.cuda.current_stream(device)
+    _check(hip.hipModuleLaunchKernel(function, 41, 1, 1, rows * 64, 1, 1, 0,
+                                     _ptr(stream.cuda_stream), args, None))
+    return tokens, weights, experts, sizes, output
+
+
+def try_qwen4_verify(model, hidden_states, logits):
+    if not (_ENABLED and is_rtpllm() and rtp_single_verify.get() and is_mi308x(logits.device)):
+        return None
+    ex = model.experts
+    quant = ex.quant_method
+    if not (
+        model.tp_size == 2 and model.n_routed_experts == 512 and ex.top_k == 10
+        and ex.renormalize and ex.scoring_func == "softmax" and not ex.use_grouped_topk
+        and ex.custom_routing_function is None and ex.e_score_correction_bias is None
+        and ex.balance_router_logits is None and ex.routed_scaling_factor == 1
+        and ex.shared_expert_scoring_func == "sigmoid" and ex.num_fused_shared_experts == 1
+        and ex.activation == ActivationType.Silu and not ex.apply_router_weight_on_input and not ex.reduce_results
+        and ex.moe_parallel_config.dp_size == 1 and ex.moe_parallel_config.dp_logical_ratio == 1
+        and quant.__class__.__name__ == "CompressedTensorsFp8MoEMethod"
+        and quant.fused_experts is None and quant.quant_type == QuantType.per_Token
+        and logits.shape in ((4, 513), (8, 513)) and logits.dtype == torch.bfloat16 and logits.is_contiguous()
+    ):
+        return None
+    # These buffers carry the preinitialized rank-specific shared and dummy expert IDs.
+    weights, ids = topk_meta_rows(logits.shape[0])
+    return maybe_small_decode(
+        hidden_states, ex.w13_weight, ex.w2_weight, weights, ids, ex.expert_mask,
+        ActivationType.Silu, quant.quant_type, False, ex.w13_weight_scale, ex.w2_weight_scale,
+        getattr(ex, "w13_input_scale", None), getattr(ex, "w2_input_scale", None),
+        getattr(ex, "swiglu_limit", 0.0), "separated", None, router_logits=logits,
+    )
