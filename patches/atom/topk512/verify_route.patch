+++ b/atom/plugin/rtpllm/utils/qwen4_verify_route.hip
@@ -0,0 +1,216 @@
+#include <hip/hip_bfloat16.h>
+#include <hip/hip_runtime.h>
+#include <math.h>
+#include <stdint.h>
+
+// One wave per verifier row. The kGlobalExperts-expert bitmap replaces Opus'
+// global workspace.
+constexpr int kGlobalExperts = 514; // 512 routed, one shared, one masked dummy.
+#ifdef QWEN4_VERIFY_EIGHT_ROWS
+template <int M> __device__ void verify_route(const hip_bfloat16 *logits,
+                                                 const int *shared_ids,
+                                                 const int *mask, int *tokens,
+                                                 float *weights, int *experts,
+                                                 int *sizes, hip_bfloat16 *out,
+                                                 const int *valid_rows) {
+#else
+constexpr int M = 4;
+extern "C" __global__ void qwen4_verify_route_m4(const hip_bfloat16 *logits,
+                                                 const int *shared_ids,
+                                                 const int *mask, int *tokens,
+                                                 float *weights, int *experts,
+                                                 int *sizes, hip_bfloat16 *out,
+                                                 const int *valid_rows) {
+#endif
+  constexpr int T = M * 64;
+  int t = threadIdx.x, row = t / 64, lane = t % 64;
+  if (blockIdx.x) {
+    int i = (blockIdx.x - 1) * T + t;
+    if (i < M * 2560)
+      out[i] = hip_bfloat16(0.f);
+    return;
+  }
+  __shared__ int hits[kGlobalExperts], group[kGlobalExperts],
+      wave_count[T / 64], wave_local[T / 64], total, total_local;
+  __shared__ int route_id[M][12];
+  __shared__ float route_w[M][12];
+  for (int i = t; i < kGlobalExperts; i += T)
+    hits[i] = 0;
+  if (t == 0) {
+    total = 0;
+    total_local = 0;
+  }
+  __syncthreads();
+  unsigned key[8];
+#pragma unroll
+  for (int j = 0; j < 8; ++j) {
+    int id = lane + 64 * j;
+    float x = float(logits[row * 513 + id]);
+    unsigned b = x == 0.f ? 0u : __float_as_uint(x) >> 16;
+    unsigned ordered = (b & 32768) ? (b ^ 65535) : (b ^ 32768);
+    key[j] = (ordered << 10) | (511 - id);
+  }
+  float first = 0.f;
+#pragma unroll
+  for (int k = 0; k < 10; ++k) {
+    unsigned best = 0;
+#pragma unroll
+    for (int j = 0; j < 8; ++j)
+      best = max(best, key[j]);
+#pragma unroll
+    for (int d = 32; d; d >>= 1)
+      best = max(best, __shfl_xor(best, d, 64));
+    int expert = 511 - (best & 511);
+#pragma unroll
+    for (int j = 0; j < 8; ++j)
+      if (key[j] == best)
+        key[j] = 0;
+    unsigned b = best >> 10;
+    b = (b & 32768) ? (b ^ 32768) : (b ^ 65535);
+    float x = __uint_as_float(b << 16);
+    if (k == 0)
+      first = x;
+    if (lane == k) {
+      route_id[row][k] = (!valid_rows || row < *valid_rows) ? expert : -1;
+      route_w[row][k] = __expf(x - first);
+    }
+  }
+  __syncthreads();
+  float w = lane < 10 ? route_w[row][lane] : 0.f;
+  for (int off = 8; off; off >>= 1)
+    w += __shfl_xor(w, off, 16);
+  if (lane < 10)
+    route_w[row][lane] /= w;
+  if (lane == 10 || lane == 11) {
+    route_id[row][lane] = shared_ids[row * 12 + lane];
+    route_w[row][lane] =
+        lane == 10 ? 1.f / (1.f + __expf(-float(logits[row * 513 + 512])))
+                   : 1.f;
+  }
+  __syncthreads();
+  if (lane < 12) {
+    int e = route_id[row][lane];
+    if (e >= 0 && mask[e])
+      atomicOr((unsigned *)&hits[e], 1u << row);
+  }
+  __syncthreads();
+#ifdef QWEN4_VERIFY_EIGHT_ROWS
+  // Eight wavefronts cover all 512 routed experts in a single ballot pass.
+  bool local = mask[t], active = local && hits[t];
+  auto active_bits = __ballot(active), local_bits = __ballot(local);
+  unsigned long long lower = (1ull << lane) - 1;
+  if (!lane) {
+    wave_count[row] = __popcll(active_bits);
+    wave_local[row] = __popcll(local_bits);
+  }
+  __syncthreads();
+  int tile = __popcll(active_bits & lower);
+  int local_id = __popcll(local_bits & lower);
+  #pragma unroll
+  for (int i = 0; i < M; ++i) {
+    if (i < row) {
+      tile += wave_count[i];
+      local_id += wave_local[i];
+    }
+  }
+  if (active) {
+    group[t] = tile;
+    experts[tile] = local_id;
+  }
+  if (t == T - 1) {
+    tile += active;
+    local_id += local;
+    for (int z = T; z < kGlobalExperts; ++z) {
+      if (mask[z]) {
+        if (hits[z]) {
+          group[z] = tile;
+          experts[tile++] = local_id;
+        }
+        ++local_id;
+      }
+    }
+    total = tile;
+    sizes[0] = tile * 16;
+    sizes[1] = M;
+  }
+  __syncthreads();
+  // Cooperatively initialize padded slots, then scatter valid routes.
+  for (int i = t; i < total * 16; i += T) {
+    tokens[i] = (12 << 24) | M;
+    weights[i] = 0.f;
+  }
+  __syncthreads();
+  // Within each expert, increasing row order matches Opus. High bits encode the
+  // TopK slot.
+  if (lane < 12) {
+    int e = route_id[row][lane];
+    if (e >= 0 && mask[e]) {
+      unsigned bits = hits[e];
+      int off = __popc(bits & ((1u << row) - 1)), start = group[e] * 16;
+      tokens[start + off] = (lane << 24) | row;
+      weights[start + off] = route_w[row][lane];
+    }
+  }
+}
+extern "C" __global__ void qwen4_verify_route_m8(const hip_bfloat16 *logits,
+                                                 const int *shared_ids,
+                                                 const int *mask, int *tokens,
+                                                 float *weights, int *experts,
+                                                 int *sizes, hip_bfloat16 *out,
+                                                 const int *valid_rows) {
+  verify_route<8>(logits, shared_ids, mask, tokens, weights, experts, sizes, out, valid_rows);
+}
+#else
+  // Prefix sums over local and active experts map each routed group to a 16-row
+  // tile.
+  for (int base = 0; base < kGlobalExperts; base += T) {
+    int e = base + t;
+    bool local = e < kGlobalExperts && mask[e], active = local && hits[e];
+    unsigned long long av = __ballot(active), lv = __ballot(local);
+    unsigned long long prior = (1ull << lane) - 1;
+    if (lane == 0) {
+      wave_count[row] = __popcll(av);
+      wave_local[row] = __popcll(lv);
+    }
+    __syncthreads();
+    int g = total + __popcll(av & prior),
+        lid = total_local + __popcll(lv & prior);
+    for (int i = 0; i < row; i++) {
+      g += wave_count[i];
+      lid += wave_local[i];
+    }
+    if (active) {
+      group[e] = g;
+      experts[g] = lid;
+    }
+    __syncthreads();
+    if (t == 0) {
+      for (int i = 0; i < M; i++) {
+        total += wave_count[i];
+        total_local += wave_local[i];
+      }
+    }
+    __syncthreads();
+  }
+  if (t == 0) {
+    sizes[0] = total * 16;
+    sizes[1] = M;
+  }
+  // Within each expert, increasing row order matches Opus. High bits encode the
+  // TopK slot.
+  if (lane < 12) {
+    int e = route_id[row][lane];
+    if (e >= 0 && mask[e]) {
+      unsigned bits = hits[e];
+      int off = __popc(bits & ((1u << row) - 1)), start = group[e] * 16;
+      tokens[start + off] = (lane << 24) | row;
+      weights[start + off] = route_w[row][lane];
+      if (off == 0)
+        for (int j = __popc(bits); j < 16; j++) {
+          tokens[start + j] = (12 << 24) | M;
+          weights[start + j] = 0.f;
+        }
+    }
+  }
+}
+#endif
