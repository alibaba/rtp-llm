@@ -0,0 +1,254 @@
+"""Experimental RTP Qwen3.8 ReplaySSM state bridge.
+
+The RTP linear block pool keeps full checkpoints. ReplaySSM records are attached
+per physical block; the accepted candidate receives the checkpoint and records
+before RTP advances its block table. No transaction is published on a failed
+prepare. A failure after mutation is fail-stop rather than serving bad state.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from types import MethodType
+import os
+
+import torch
+
+from atom.model_ops.fla_ops.replayssm import replayssm_buffer_shapes, replayssm_commit
+from atom.plugin.rtpllm.utils.replayssm_rtp_fused_copy import (
+    make_layer_pointer_tables, copy_replay_slot_with_version,
+    commit_copy_versioned,
+)
+
+
+@dataclass
+class _Stage:
+    src: torch.Tensor
+    candidates: torch.Tensor
+    width: int
+    read: torch.Tensor
+
+
+def enabled(runtime) -> bool:
+    return os.getenv("ATOM_RTP_ENABLE_REPLAYSSM", "0") == "1" and bool(
+        getattr(getattr(runtime, "_rtp_model_config", None), "atom_qwen4_exp_mtp_target", False)
+    )
+
+
+def allocate_buffers(runtime, caches, layer_maps) -> None:
+    if not enabled(runtime):
+        return
+    count = 0
+    cap = 16
+    for layer_num in sorted(layer_maps[0]):
+        cache = caches[f"layer_{layer_num}"]
+        state = cache.v_cache
+        if state.ndim != 4 or state.dtype != torch.float32:
+            raise RuntimeError("RTP ReplaySSM requires FP32 GDN checkpoint state")
+        slots, heads, key_dim, value_dim = map(int, state.shape)
+        if count and count != slots:
+            raise RuntimeError("RTP ReplaySSM state slot counts differ by layer")
