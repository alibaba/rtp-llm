+def copy_moved_blocks(runtime, mapping: torch.Tensor, tags: list[str]) -> None:
+    if not enabled(runtime) or "linear" not in tags:
+        return
+    if not hasattr(runtime, "_rtp_replay_write_pos"):
+        raise RuntimeError("ReplaySSM copy requested before pool initialization")
+    row = tags.index("linear")
+    moves = mapping[mapping[:, 0] == row]
+    if not moves.numel():
+        return
+    src = moves[:, 1].to(device=runtime._rtp_replay_write_pos.device, dtype=torch.int64, non_blocking=True)
+    dst = moves[:, 2].to(device=src.device, dtype=torch.int64, non_blocking=True)
+    if os.getenv("ATOM_RTP_REPLAY_DEBUG") == "1" and runtime._rtp_replay_debug_count < 36:
+        print("REPLAY_COPY", runtime._rtp_replay_debug_count, "src", src[:5].tolist(), "dst", dst[:5].tolist(), "tags", tags, flush=True)
+        runtime._rtp_replay_debug_count += 1
+    # Relocation mappings may overlap or form chains. Gather all sources
+    # before writes, preserving RTP's native block-copy semantics.
+    for layer_num in sorted(runtime._rtp_layer_maps[0]):
+        cache = runtime._rtp_kv_cache_data[f"layer_{layer_num}"]
+        for tensor in (cache.replay_buf_k, cache.replay_buf_u, cache.replay_buf_g):
+            tensor.index_copy_(0, dst, tensor.index_select(0, src))
+    pos = runtime._rtp_replay_write_pos
+    pos.index_copy_(0, dst, pos.index_select(0, src))
+    version = runtime._rtp_replay_state_version
+    version.index_copy_(0, dst, version.index_select(0, src))
