+@triton.jit
+def _copy_replay_slot_with_version(
+    state_ptrs,k_ptrs,u_ptrs,g_ptrs,cursor,version,reads,writes,copy_flags,
+    STATE_ELEMS:tl.constexpr,STATE_STRIDE:tl.constexpr,
+    K_ELEMS:tl.constexpr,U_ELEMS:tl.constexpr,G_ELEMS:tl.constexpr,
+    BLOCK:tl.constexpr,
+):
+    row=tl.program_id(0);tile=tl.program_id(1);layer=tl.program_id(2)
+    src=tl.load(reads+row).to(tl.int64)
+    dst=tl.load(writes+row).to(tl.int64)
