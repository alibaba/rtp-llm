+        state=tl.load(state_ptrs+layer).to(tl.pointer_type(tl.float32))
+        rk=tl.load(k_ptrs+layer).to(tl.pointer_type(tl.bfloat16))
+        ru=tl.load(u_ptrs+layer).to(tl.pointer_type(tl.bfloat16))
+        rg=tl.load(g_ptrs+layer).to(tl.pointer_type(tl.float32))
+        off=tile*BLOCK+tl.arange(0,BLOCK)
+        if tl.load(copy_flags+row) != 0:
+            x=tl.load(state+src*STATE_STRIDE+off,mask=off<STATE_ELEMS,other=0)
+            tl.store(state+dst*STATE_STRIDE+off,x,mask=off<STATE_ELEMS)
+        if tile*BLOCK<K_ELEMS:
+            xk=tl.load(rk+src*K_ELEMS+off,mask=off<K_ELEMS,other=0)
+            tl.store(rk+dst*K_ELEMS+off,xk,mask=off<K_ELEMS)
+        if tile*BLOCK<U_ELEMS:
+            xu=tl.load(ru+src*U_ELEMS+off,mask=off<U_ELEMS,other=0)
+            tl.store(ru+dst*U_ELEMS+off,xu,mask=off<U_ELEMS)
+        if tile*BLOCK<G_ELEMS:
+            xg=tl.load(rg+src*G_ELEMS+off,mask=off<G_ELEMS,other=0)
+            tl.store(rg+dst*G_ELEMS+off,xg,mask=off<G_ELEMS)
+        if tile==0 and layer==0:
+            tl.store(cursor+dst,tl.load(cursor+src))
+            tl.store(version+dst,tl.load(version+src))
+
+
+@triton.jit
+def _prepare_versioned_commit(
+    cursor,version,sources,candidates,accepts,
+    out_dst,out_pos,out_version,out_copy,
+    ACTIVE:tl.constexpr,ROW_STRIDE:tl.constexpr,COL_STRIDE:tl.constexpr,
+    WIDTH:tl.constexpr,CAP:tl.constexpr,VERSION_DELTA:tl.constexpr,
+    EPOCH_BASE, UNIQUE_VERSION:tl.constexpr,
+):
+    row=tl.program_id(0)
+    dst=tl.full((),-1,tl.int64)
+    if row<ACTIVE:
+        src=tl.load(sources+row).to(tl.int64)
+        accepted=tl.load(accepts+row)
+        if src>=0 and accepted>0:
+            step=tl.minimum(accepted-1,WIDTH-1)
+            dst=tl.load(candidates+row*ROW_STRIDE+step*COL_STRIDE).to(tl.int64)
+            if dst>=0:
+                h=tl.load(cursor+src)
+                flushed=h>=0 and h+2*WIDTH>CAP
+                base=tl.where(flushed,0,h)
+                new_pos=tl.where(h<0,0,base+accepted)
+                src_version=tl.load(version+src)
+                dst_version=tl.load(version+dst)
+                new_version=src_version+tl.where(flushed,VERSION_DELTA,0)
+                if UNIQUE_VERSION:
+                    new_version=tl.where(flushed,EPOCH_BASE+src,src_version)
+                copy_state=flushed or src_version!=dst_version
+                tl.store(out_pos+row,new_pos)
+                tl.store(out_version+row,new_version)
+                tl.store(out_copy+row,copy_state.to(tl.int32))
+    tl.store(out_dst+row,dst)
+
+
+@triton.jit
+def _copy_versioned_commit(
+    state_ptrs,k_ptrs,u_ptrs,g_ptrs,cursor,version,sources,
+    dsts,new_positions,new_versions,copy_flags,
+    STATE_ELEMS:tl.constexpr,STATE_STRIDE:tl.constexpr,
+    K_ELEMS:tl.constexpr,U_ELEMS:tl.constexpr,G_ELEMS:tl.constexpr,
+    BLOCK:tl.constexpr,
+):
+    row=tl.program_id(0);tile=tl.program_id(1);layer=tl.program_id(2)
+    src=tl.load(sources+row).to(tl.int64)
+    dst=tl.load(dsts+row).to(tl.int64)
+    if src>=0 and dst>=0:
+        if src!=dst:
+            off=tile*BLOCK+tl.arange(0,BLOCK)
+            if tl.load(copy_flags+row)!=0:
+                state=tl.load(state_ptrs+layer).to(tl.pointer_type(tl.float32))
+                x=tl.load(state+src*STATE_STRIDE+off,mask=off<STATE_ELEMS,other=0)
+                tl.store(state+dst*STATE_STRIDE+off,x,mask=off<STATE_ELEMS)
+            if tile*BLOCK<K_ELEMS:
+                rk=tl.load(k_ptrs+layer).to(tl.pointer_type(tl.bfloat16))
+                xk=tl.load(rk+src*K_ELEMS+off,mask=off<K_ELEMS,other=0)
+                tl.store(rk+dst*K_ELEMS+off,xk,mask=off<K_ELEMS)
+            if tile*BLOCK<U_ELEMS:
+                ru=tl.load(u_ptrs+layer).to(tl.pointer_type(tl.bfloat16))
+                xu=tl.load(ru+src*U_ELEMS+off,mask=off<U_ELEMS,other=0)
+                tl.store(ru+dst*U_ELEMS+off,xu,mask=off<U_ELEMS)
+            if tile*BLOCK<G_ELEMS:
+                rg=tl.load(g_ptrs+layer).to(tl.pointer_type(tl.float32))
+                xg=tl.load(rg+src*G_ELEMS+off,mask=off<G_ELEMS,other=0)
+                tl.store(rg+dst*G_ELEMS+off,xg,mask=off<G_ELEMS)
+        if tile==0 and layer==0:
+            p=tl.load(new_positions+row)
+            ver=tl.load(new_versions+row)
+            tl.store(cursor+src,p)
+            tl.store(cursor+dst,p)
+            tl.store(version+src,ver)
+            tl.store(version+dst,ver)
+
+
+def copy_replay_slot_with_version(tables,sizes,cursor,version,reads,writes,copy_flags=None):
+    if reads.numel() != writes.numel():
+        raise RuntimeError("ReplaySSM pre-copy row mismatch")
+    if reads.numel() == 0:
+        return
+    if copy_flags is None:
+        copy_flags = torch.empty(reads.numel(), device=reads.device, dtype=torch.int32)
+    if copy_flags.numel() < reads.numel():
+        raise RuntimeError("ReplaySSM pre-copy scratch capacity exceeded")
+    _snapshot_precopy_versions[(1,)](
+        version, reads, writes, copy_flags, reads.numel(),
+        triton.next_power_of_2(reads.numel()), num_warps=1)
+    block=4096
+    grid=(reads.numel(),triton.cdiv(max(sizes[0],*sizes[2:]),block),tables[0].numel())
+    _copy_replay_slot_with_version[grid](
+        *tables,cursor,version,reads,writes,copy_flags,*sizes,block,num_warps=4)
+
+
+def commit_copy_versioned(tables,sizes,cursor,version,sources,candidates,accepts,
+                          dst_buffer,pos_buffer,version_buffer,copy_buffer,cap,epoch_base=None):
+    if accepts.dtype!=torch.int32 or accepts.ndim!=1 or accepts.numel()>sources.numel():
+        raise RuntimeError("ReplaySSM versioned commit accept shape/dtype mismatch")
+    rows=sources.numel()
+    _prepare_versioned_commit[(rows,)](
+        cursor,version,sources,candidates,accepts,
+        dst_buffer,pos_buffer,version_buffer,copy_buffer,
+        accepts.numel(),candidates.stride(0),candidates.stride(1),
+        candidates.shape[1],cap,1<<32,
+        0 if epoch_base is None else epoch_base, epoch_base is not None,num_warps=1)
+    block=4096
+    grid=(rows,triton.cdiv(max(sizes[0],*sizes[2:]),block),tables[0].numel())
+    _copy_versioned_commit[grid](
+        *tables,cursor,version,sources,
+        dst_buffer,pos_buffer,version_buffer,copy_buffer,
+        *sizes,block,num_warps=4)
