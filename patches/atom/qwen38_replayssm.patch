+def make_layer_pointer_tables(caches: list, device: torch.device):
+    names = ("v_cache", "replay_buf_k", "replay_buf_u", "replay_buf_g")
+    tables = []
+    sizes = tuple(getattr(caches[0], name)[0].numel() for name in names)
+    state_stride = caches[0].v_cache.stride(0)
+    for name, size in zip(names, sizes):
+        tensors = [getattr(cache, name) for cache in caches]
+        if name == "v_cache":
+            inner = tensors[0].stride()[1:]
+            if not all(t[0].is_contiguous() and t[0].numel() == size and
+                       t.stride(0) == state_stride and t.stride()[1:] == inner for t in tensors):
+                raise RuntimeError("RTP ReplaySSM GDN state layouts differ")
+        elif not all(t.is_contiguous() and t[0].numel() == size for t in tensors):
+            raise RuntimeError(f"RTP ReplaySSM record layout differs for {name}")
+        tables.append(torch.tensor([t.data_ptr() for t in tensors], device=device, dtype=torch.int64))
+    return tuple(tables), (sizes[0], state_stride, *sizes[1:])
+
+
+def copy_all_replay_slots(tables, sizes, cursor: torch.Tensor, reads: torch.Tensor, writes: torch.Tensor):
+    if reads.numel() != writes.numel():
+        raise RuntimeError("RTP ReplaySSM copy row mismatch")
+    block = 1024
+    grid = (reads.numel(), triton.cdiv(max(sizes[0], *sizes[2:]), block), tables[0].numel())
+    _copy_all_replay_slots[grid](*tables, cursor, reads, writes, *sizes, block, num_warps=4)
+
