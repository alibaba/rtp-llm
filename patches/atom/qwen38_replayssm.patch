+"""Fused checkpoint, record, and cursor copy for RTP ReplaySSM slots."""
+import math
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _copy_replay_slot(
+    state, record_k, record_u, record_g, cursor, reads, writes,
+    STATE_ELEMS: tl.constexpr,
+    K_ELEMS: tl.constexpr,
+    U_ELEMS: tl.constexpr,
+    G_ELEMS: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    tile = tl.program_id(1)
+    src = tl.load(reads + row).to(tl.int64)
+    dst = tl.load(writes + row).to(tl.int64)
+    if src >= 0 and dst >= 0 and src != dst:
+        offset = tile * BLOCK + tl.arange(0, BLOCK)
+        v = tl.load(state + src * STATE_ELEMS + offset, mask=offset < STATE_ELEMS, other=0)
+        tl.store(state + dst * STATE_ELEMS + offset, v, mask=offset < STATE_ELEMS)
+        if tile * BLOCK < K_ELEMS:
+            k = tl.load(record_k + src * K_ELEMS + offset, mask=offset < K_ELEMS, other=0)
+            tl.store(record_k + dst * K_ELEMS + offset, k, mask=offset < K_ELEMS)
+        if tile * BLOCK < U_ELEMS:
+            u = tl.load(record_u + src * U_ELEMS + offset, mask=offset < U_ELEMS, other=0)
+            tl.store(record_u + dst * U_ELEMS + offset, u, mask=offset < U_ELEMS)
+        if tile * BLOCK < G_ELEMS:
+            g = tl.load(record_g + src * G_ELEMS + offset, mask=offset < G_ELEMS, other=0)
+            tl.store(record_g + dst * G_ELEMS + offset, g, mask=offset < G_ELEMS)
+        if tile == 0:
+            tl.store(cursor + dst, tl.load(cursor + src))
+
+
+def copy_replay_slot(cache, cursor: torch.Tensor, reads: torch.Tensor, writes: torch.Tensor) -> None:
+    tensors = (cache.v_cache, cache.replay_buf_k, cache.replay_buf_u, cache.replay_buf_g)
+    if not all(t.is_contiguous() for t in tensors):
+        raise RuntimeError("RTP ReplaySSM fused copy requires contiguous state and record buffers")
+    if reads.numel() != writes.numel():
+        raise RuntimeError("RTP ReplaySSM fused copy row mismatch")
+    sizes = tuple(t[0].numel() for t in tensors)
+    block = 2048
+    grid = (reads.numel(), triton.cdiv(max(sizes), block))
+    _copy_replay_slot[grid](*tensors, cursor, reads, writes, *sizes, block, num_warps=4)
+
+
+@triton.jit
+def _copy_all_replay_slots(
+    state_ptrs, k_ptrs, u_ptrs, g_ptrs, cursor, reads, writes,
+    STATE_ELEMS: tl.constexpr,
+    STATE_STRIDE: tl.constexpr,
+    K_ELEMS: tl.constexpr,
+    U_ELEMS: tl.constexpr,
+    G_ELEMS: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    tile = tl.program_id(1)
+    layer = tl.program_id(2)
+    src = tl.load(reads + row).to(tl.int64)
+    dst = tl.load(writes + row).to(tl.int64)
+    if src >= 0 and dst >= 0 and src != dst:
+        state = tl.load(state_ptrs + layer).to(tl.pointer_type(tl.float32))
+        record_k = tl.load(k_ptrs + layer).to(tl.pointer_type(tl.bfloat16))
+        record_u = tl.load(u_ptrs + layer).to(tl.pointer_type(tl.bfloat16))
+        record_g = tl.load(g_ptrs + layer).to(tl.pointer_type(tl.float32))
+        offset = tile * BLOCK + tl.arange(0, BLOCK)
+        v = tl.load(state + src * STATE_STRIDE + offset, mask=offset < STATE_ELEMS, other=0)
+        tl.store(state + dst * STATE_STRIDE + offset, v, mask=offset < STATE_ELEMS)
+        if tile * BLOCK < K_ELEMS:
+            k = tl.load(record_k + src * K_ELEMS + offset, mask=offset < K_ELEMS, other=0)
+            tl.store(record_k + dst * K_ELEMS + offset, k, mask=offset < K_ELEMS)
+        if tile * BLOCK < U_ELEMS:
+            u = tl.load(record_u + src * U_ELEMS + offset, mask=offset < U_ELEMS, other=0)
+            tl.store(record_u + dst * U_ELEMS + offset, u, mask=offset < U_ELEMS)
+        if tile * BLOCK < G_ELEMS:
+            g = tl.load(record_g + src * G_ELEMS + offset, mask=offset < G_ELEMS, other=0)
+            tl.store(record_g + dst * G_ELEMS + offset, g, mask=offset < G_ELEMS)
+        if tile == 0 and layer == 0:
+            tl.store(cursor + dst, tl.load(cursor + src))
