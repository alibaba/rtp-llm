+    # candidate blocks. ReplaySSM addresses checkpoint and records by one
+    # slot, so fork all side state to candidate zero before the captured GDN.
+    copy_replay_slot_with_version(
+        runtime._rtp_replay_layer_ptrs, runtime._rtp_replay_layer_sizes,
+        pos, runtime._rtp_replay_state_version, read, src,
