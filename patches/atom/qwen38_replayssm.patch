+def prepare_metadata(runtime, metadata) -> None:
+    if not enabled(runtime) or metadata is None:
+        return
+    pos = getattr(runtime, "_rtp_replay_write_pos", None)
+    if pos is None:
+        raise RuntimeError("RTP ReplaySSM buffers were not allocated")
+    if metadata.num_prefills:
+        runtime._rtp_replay_epoch += 1
+        epoch_base = runtime._rtp_replay_epoch * pos.numel()
+        version = runtime._rtp_replay_state_version
+        def reset_slots(slots):
+            indices = slots.reshape(-1).to(torch.int64)
+            pos.index_fill_(0, indices, 0)
+            version.index_copy_(0, indices, indices + epoch_base)
+        slots = metadata.non_spec_state_indices_tensor
+        if slots is not None:
+            reset_slots(slots)
+        checkpoints = metadata.ssm_checkpoints
+        if checkpoints is not None:
+            cp_slots = checkpoints.get("slots")
+            if cp_slots is not None and cp_slots.numel():
+                reset_slots(cp_slots)
+        return
+    if not metadata.num_spec_decodes:
+        return
+    candidates = metadata.spec_state_indices_tensor
+    if candidates is None or candidates.ndim != 2:
+        raise RuntimeError("RTP ReplaySSM requires candidate state slots [B,Q]")
+    src = candidates[:, 0].contiguous()
+    read = metadata.spec_state_indices_in_tensor[:, 0].contiguous()
+    if read.shape != src.shape:
