+    runtime._rtp_replay_commit_pos = torch.empty(request_capacity, device=state.device, dtype=torch.int32)
+    runtime._rtp_replay_commit_version = torch.empty(request_capacity, device=state.device, dtype=torch.int64)
+    runtime._rtp_replay_commit_copy = torch.empty(request_capacity, device=state.device, dtype=torch.int32)
