+@triton.jit
+def _snapshot_precopy_versions(version, reads, writes, copy_flags, ROWS: tl.constexpr,
+                               BLOCK: tl.constexpr):
+    # Freeze decisions before any destination version is published by copy CTAs.
+    row = tl.arange(0, BLOCK)
+    valid = row < ROWS
+    src = tl.load(reads + row, mask=valid, other=-1).to(tl.int64)
+    dst = tl.load(writes + row, mask=valid, other=-1).to(tl.int64)
+    active = valid & (src >= 0) & (dst >= 0) & (src != dst)
+    src_ver = tl.load(version + src, mask=active, other=0)
+    dst_ver = tl.load(version + dst, mask=active, other=0)
+    tl.store(copy_flags + row, active & (src_ver != dst_ver), mask=valid)
+
