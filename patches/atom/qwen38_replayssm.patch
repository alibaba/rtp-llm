+def commit_copy_all_replay_slots(
+    tables, sizes, cursor: torch.Tensor, sources: torch.Tensor,
+    candidates: torch.Tensor, accepts: torch.Tensor, cap: int,
+) -> None:
+    if accepts.ndim != 1 or accepts.dtype != torch.int32:
+        raise RuntimeError("RTP ReplaySSM accept lengths must be int32 [batch]")
+    if accepts.numel() > sources.numel():
+        raise RuntimeError("RTP ReplaySSM accept batch exceeds captured slot batch")
+    block=1024
+    grid=(sources.numel(),triton.cdiv(max(sizes[0],*sizes[2:]),block),tables[0].numel())
+    _commit_copy_all_replay_slots[grid](
+        *tables,cursor,sources,candidates,accepts,
+        accepts.numel(),candidates.stride(0),candidates.stride(1),
+        candidates.shape[1],cap,*sizes,block,num_warps=4,
+    )
