+void BlockTree::observeCacheState(const TreeNode* node, const char* trigger) {
+    if (!observability_enabled_ || node == root_.get()) {
+        return;
+    }
+    if (observation_batch_depth_ > 0) {
+        deferObservationRoot(node, trigger);
