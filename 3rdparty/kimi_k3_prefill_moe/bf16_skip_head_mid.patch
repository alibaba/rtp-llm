@@ -20,0 +22,28 @@
+
+static void bf16_gemm_nt_skip_head_mid(const torch::Tensor& a,
+                                       const torch::Tensor& b,
+                                       const torch::Tensor& d,
+                                       const std::tuple<int, int, int>& head_splits,
+                                       const std::string& compiled_dims) {
+    const auto major_a = get_major_type_ab(a);
+    const auto major_b = get_major_type_ab(b);
+    check_major_type_cd(d);
+    const auto [m, k] = get_shape<2>(a);
+    const auto [n, b_k] = get_shape<2>(b);
+    const auto [d_m, d_n] = get_shape<2>(d);
+    const auto [left, mid, right] = head_splits;
+    DG_HOST_ASSERT(m == d_m and k == b_k and n > 0 and k > 0);
+    DG_HOST_ASSERT(a.scalar_type() == torch::kBFloat16);
+    DG_HOST_ASSERT(b.scalar_type() == torch::kBFloat16);
+    DG_HOST_ASSERT(d.scalar_type() == torch::kBFloat16);
+    DG_HOST_ASSERT(left > 0 and mid > 0 and right > 0);
+    DG_HOST_ASSERT(n % (left + right) == 0);
+    DG_HOST_ASSERT(d_n == n + n / (left + right) * mid);
+    DG_HOST_ASSERT(jit->device.get_arch_major() == 10);
+    if (m == 0)
+        return;
+    const auto epilogue_type = std::format(
+        "epilogue::transform::EpilogueHeadSplits<{}, {}, {}>", left, mid, right);
+    sm100_bf16_gemm(a, b, std::nullopt, d, m, n, k, major_a, major_b,
+                    compiled_dims, std::nullopt, epilogue_type);
+}
