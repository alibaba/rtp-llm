config_setting(
    name = "using_cuda",
    values = {"define": "using_cuda=true"},
)

config_setting(
    name = "using_rocm",
    values = {"define": "using_rocm=true"},
)

cc_library(
    name = "torch",
    srcs = [
        "torch/lib/libtorch.so",
        "torch/lib/libtorch_python.so",
        "torch/lib/libtorch_cpu.so",
        "torch/lib/libshm.so",
        "torch/lib/libc10.so",
    ] + glob([
        "torch/lib/libgomp*.so*",
    ]) + select({
        "@//:using_cuda": [
            "torch/lib/libtorch_cuda.so",
            "torch/lib/libc10_cuda.so",
        ] + glob([
            "torch/lib/libcudart*.so*",
            "torch/lib/libnvToolsExt*.so*",
            # Some CUDA wheels reference Torch's optional NVSHMEM library.
            # Include it when present; older wheels keep their existing layout.
            "torch/lib/libtorch_nvshmem*.so*",
        ]),
        "@//:using_rocm": [
            # "torch/lib/librocfft.so",
            # "torch/lib/librocsolver.so",
            # "torch/lib/libnuma.so",
            "torch/lib/libcaffe2_nvrtc.so",
            "torch/lib/libtorch_hip.so",
            "torch/lib/libc10_hip.so",
        ] +  glob([
            "torch/lib/libaotriton_v2.so*",
            # "torch/lib/libmagma*.so*",
            # "torch/lib/libtinfo.so*",
            # "torch/lib/libsuitesparseconfig.so*",
            # "torch/lib/libcholmod.so*",
            # "torch/lib/libsatlas.so*",
            # "torch/lib/libgfortran.so*",
            # "torch/lib/libquadmath.so*",
            # "torch/lib/libgomp*.so*",
            # "torch/lib/libhip*.so*",
            # "torch/lib/lib*amd*.so*",
        ]),
        "//conditions:default": [],
    }) + select({
        # Torch's NVIDIA dependencies come from the wheel repositories on
        # CUDA 13 build hosts that only provide the CUDA toolkit.
        "@//:using_cuda13_x86": [
            "@pip_gpu_cuda13_torch_nvidia_nvshmem_cu13//:site-packages/nvidia/nvshmem/lib/libnvshmem_host.so.3",
            "@pip_gpu_cuda13_torch_nvidia_cusparselt_cu13//:site-packages/nvidia/cusparselt/lib/libcusparseLt.so.0",
            "@pip_gpu_cuda13_torch_nvidia_nccl_cu13//:site-packages/nvidia/nccl/lib/libnccl.so.2",
        ] + [
            "@pip_gpu_cuda13_torch_nvidia_cudnn_cu13//:site-packages/nvidia/cudnn/lib/libcudnn" + suffix + ".so.9"
            for suffix in [
                "",
                "_adv",
                "_cnn",
                "_engines_precompiled",
                "_engines_runtime_compiled",
                "_graph",
                "_heuristic",
                "_ops",
            ]
        ],
        "//conditions:default": [],
    }),
    hdrs = glob([
        "torch/include/*.h",
        "torch/include/**/*.h",
        "torch/include/**/*.cuh",
        "torch/include/**/*.hpp",
    ], exclude=["torch/include/google/**"]),
    deps = [
        "@local_config_python//:python_headers",
        "@local_config_python//:python_lib",
    ],
    strip_include_prefix = "torch/include",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "torch_api",
    hdrs = glob([
        "torch/include/torch/csrc/api/include/**/*.h",
    ]),
    deps = [
        "@local_config_python//:python_headers",
    ],
    strip_include_prefix = "torch/include/torch/csrc/api/include",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "torch_libs",
    srcs = glob([
        "torch.libs/libarm_compute*.so",
        "torch.libs/libgfortran*.so*",
        "torch.libs/libgomp*.so*",
        "torch.libs/libopenblasp*.so",
    ]),
    linkopts = select({
        "@//:cuda_pre_12_9": [
            "-L/usr/local/cuda/lib64",
            "-L/usr/local/cuda/extras/CUPTI/lib64",
            "-lcupti",
            "-lcudart",
            "-lnccl",
            "-lcudnn",
            "-lnvToolsExt",
        ],
        "@//:using_cuda12_9_x86": [
            "-L/usr/local/cuda/lib64",
            "-L/usr/local/cuda/extras/CUPTI/lib64",
            "-lcupti",
            "-lcudart",
            "-lnccl",
            "-lcudnn",
            "-lnvtx3interop",
        ],
        "@//:using_cuda13_x86": [
            "-L/usr/local/cuda/lib64",
            "-L/usr/local/cuda/extras/CUPTI/lib64",
            "-lcupti",
            "-lcudart",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "@local_config_python//:python_headers",
    ],
    visibility = ["//visibility:public"],
)
